<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>PublicityHub Admin</title>

    <style>
        :root {
            --bg-main: #f7fafc;
            --text-main: #0f172a;
            --card-bg: #ffffff;
        }

        body[data-theme="dark"] {
            --bg-main: #020617;
            --text-main: #e5e7eb;
            --card-bg: #0f172a;
        }

        body {
            font-family: Arial, system-ui, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            margin: 0;
        }

        .admin-header {
            display: flex;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .logo {
            font-weight: 600;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 40px;
            flex-grow: 1;
        }

            .nav-links a {
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
            }

                .nav-links a:hover {
                    text-decoration: underline;
                }

        .theme-btn,
        .lang-btn {
            background: none;
            border: 1px solid #94a3b8;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            color: white;
            margin-left: 10px;
        }

            .theme-btn:hover,
            .lang-btn:hover {
                background: rgba(255,255,255,0.1);
            }

        .success-box {
            background: #dcfce7;
            color: #166534;
            padding: 10px;
            border-radius: 8px;
            margin: 15px;
            font-weight: 600;
        }
    </style>
</head>

<body data-theme="light">

    <header class="admin-header">

        <div class="logo">PublicityHub Panel</div>

        <!-- ✅ ADMIN NAV -->
        <nav class="nav-links" id="adminNav">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision">Vision</a>
            <a href="/User/Create">Create User</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ✅ PROVIDER NAV -->
        <nav class="nav-links" id="providerNav" style="display:none;">
            <a href="/Provider/Dashboard">Dashboard</a>
            <a href="/Campaign/Create">Create Campaign</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ✅ LOGOUT ONLY -->
        <nav class="nav-links" id="logoutOnly" style="display:none;">
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <div>
            <button id="themeToggle" class="theme-btn">🌙 / ☀️</button>
            <button onclick="setLang('en')" class="lang-btn">EN</button>
            <button onclick="setLang('ta')" class="lang-btn">தமிழ்</button>
        </div>

    </header>

    @if (TempData["Success"] != null)
    {
        <div class="success-box">@TempData["Success"]</div>
    }

    @RenderBody()

    <!-- ✅ API -->
    <script src="/js/api.js"></script>

    <!-- ✅ ROLE + NAV CONTROL -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const token = localStorage.getItem("token");

            const adminNav = document.getElementById("adminNav");
            const providerNav = document.getElementById("providerNav");
            const logoutOnly = document.getElementById("logoutOnly");

            if (!token) {
                if (adminNav) adminNav.style.display = "none";
                if (providerNav) providerNav.style.display = "none";
                if (logoutOnly) logoutOnly.style.display = "flex";
                return;
            }

            try {
                const payload = JSON.parse(atob(token.split('.')[1]));

                const role =
                    payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];

                console.log("User role:", role);

                if (role && role.toLowerCase() === "admin") {
                    adminNav.style.display = "flex";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "none";
                }
                else if (role && role.toLowerCase() === "provider") {
                    adminNav.style.display = "none";
                    providerNav.style.display = "flex";
                    logoutOnly.style.display = "none";
                }
                else {
                    adminNav.style.display = "none";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "flex";
                }

            } catch (e) {
                console.error("Token parse error", e);
                adminNav.style.display = "none";
                providerNav.style.display = "none";
                logoutOnly.style.display = "flex";
            }

        });
    </script>

    <!-- ✅ THEME -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const btn = document.getElementById("themeToggle");

            if (btn) {
                btn.addEventListener("click", function () {
                    const current = document.body.getAttribute("data-theme");
                    const next = current === "dark" ? "light" : "dark";

                    document.body.setAttribute("data-theme", next);
                    localStorage.setItem("theme", next);
                });
            }

            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) {
                document.body.setAttribute("data-theme", savedTheme);
            }
        });
    </script>

    <!-- ✅ LANGUAGE -->
    <script>
        function setLang(lang) {
            window.location.href = "/Account/SetLanguage?lang=" + lang;
        }
    </script>

    <!-- ✅ LOGOUT -->
    <script>
        function logout() {
            localStorage.removeItem("token");
            window.location.href = "/Account/Login";
        }
    </script>

    <!-- ✅ API BASE -->
    <script>
        window.API_BASE = window.location.hostname === "localhost"
            ? "https://localhost:7166"
            : "";
    </script>

    <!-- ✅ jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>