<!DOCTYPE html>
<html>
<head>
    <title>PublicityHub Admin</title>
    <style>
        body {
            font-family: Arial;
            background: #f5f7fb;
        }
        header {
            background: #1f2937;
            color: white;
            padding: 15px;
            font-size: 22px;
        }
        .card {
            background: white;
            padding: 20px;
            margin: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .nav-links a {
            margin-left: 20px;
            color: #e5e7eb;
            text-decoration: none;
            font-weight: 500;
        }

        .nav-links a:hover {
                text-decoration: underline;
            }

            .nav-links a.vision {
                color: #2563eb;
                font-weight: 600;
            }
    </style>
</head>
<body>

    <header class="admin-header">
        <div class="logo">PublicityHub Admin Panel</div>

        <nav class="nav-links">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Campaign/Index">Campaigns</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision" class="vision">Vision</a>
            <a href="/Account/Logout">Logout</a>
        </nav>
    </header>

    @RenderBody()
</body>
</html>