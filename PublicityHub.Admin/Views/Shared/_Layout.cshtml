<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>PublicityHub Admin</title>

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --bg-main:    #f0f4f8;
            --text-main:  #0f172a;
            --text-muted: #6b7280;
            --card-bg:    #ffffff;
            --card-border:#e5e7eb;
            --input-bg:   #ffffff;
            --input-border:#d1d5db;
            --badge-gray: #f3f4f6;
        }

        body[data-theme="dark"] {
            --bg-main:    #0f172a;
            --text-main:  #f1f5f9;
            --text-muted: #94a3b8;
            --card-bg:    #1e293b;
            --card-border:#334155;
            --input-bg:   #1e293b;
            --input-border:#475569;
            --badge-gray: #334155;
        }

        body {
            font-family: 'Segoe UI', Arial, system-ui, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            transition: background 0.3s, color 0.3s;
        }

        /* -- Dark mode: campaign cards -- */
        body[data-theme="dark"] .campaign-card {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 16px rgba(0,0,0,0.3) !important;
        }

        body[data-theme="dark"] .campaign-card h3,
        body[data-theme="dark"] .campaign-card p,
        body[data-theme="dark"] .campaign-card strong {
            color: var(--text-main) !important;
        }

        body[data-theme="dark"] .status-badge.draft       { background: #374151 !important; color: #d1d5db !important; }
        body[data-theme="dark"] .status-badge.published   { background: #1e3a5f !important; color: #93c5fd !important; }
        body[data-theme="dark"] .status-badge.inexecution { background: #3b2a0a !important; color: #fcd34d !important; }
        body[data-theme="dark"] .status-badge.completed   { background: #0f3320 !important; color: #6ee7b7 !important; }
        body[data-theme="dark"] .status-badge.closed      { background: #3b0f0f !important; color: #fca5a5 !important; }

        body[data-theme="dark"] .badge.success { background: #0f3320 !important; color: #6ee7b7 !important; }
        body[data-theme="dark"] .badge.closed  { background: #3b0f0f !important; color: #fca5a5 !important; }

        body[data-theme="dark"] .btn.publish  { background: #1d4ed8 !important; }
        body[data-theme="dark"] .btn.complete { background: #15803d !important; }
        body[data-theme="dark"] .btn.close    { background: #b91c1c !important; }
        body[data-theme="dark"] .btn.assign   { background: #1d4ed8 !important; }
        body[data-theme="dark"] .btn.disabled { background: #334155 !important; color: #64748b !important; }

        body[data-theme="dark"] .proof-link { color: #60a5fa !important; }

        /* -- Dark mode: proof cards -- */
        body[data-theme="dark"] .proof-card {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
        }

        /* -- Dark mode: forms / inputs -- */
        body[data-theme="dark"] input,
        body[data-theme="dark"] textarea,
        body[data-theme="dark"] select {
            background: var(--input-bg) !important;
            color: var(--text-main) !important;
            border-color: var(--input-border) !important;
        }

        body[data-theme="dark"] .create-card,
        body[data-theme="dark"] .assign-card,
        body[data-theme="dark"] .upload-card,
        body[data-theme="dark"] .proof-form {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
        }

        body[data-theme="dark"] label,
        body[data-theme="dark"] .form-group label {
            color: var(--text-main) !important;
        }

        /* -- Dark mode: success box -- */
        body[data-theme="dark"] .success-box {
            background: #0f3320;
            color: #6ee7b7;
        }

        .admin-header {
            display: flex;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .logo {
            font-weight: 600;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 40px;
            flex-grow: 1;
        }

            .nav-links a {
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
            }

                .nav-links a:hover {
                    text-decoration: underline;
                }

        .theme-btn,
        .lang-btn {
            background: none;
            border: 1px solid #94a3b8;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            color: white;
            margin-left: 10px;
        }

            .theme-btn:hover,
            .lang-btn:hover {
                background: rgba(255,255,255,0.1);
            }

        /* -- Logout Modal -- */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.show { display: flex; }
        .modal-box {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 32px 36px;
            max-width: 360px;
            width: 90%;
            text-align: center;
            box-shadow: 0 24px 48px rgba(0,0,0,0.5);
            animation: modalIn 0.25s ease both;
        }
        body[data-theme="light"] .modal-box {
            background: #ffffff;
            border-color: #e5e7eb;
            box-shadow: 0 24px 48px rgba(0,0,0,0.15);
        }
        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.9) translateY(10px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-icon  { font-size: 40px; margin-bottom: 14px; }
        .modal-title { font-size: 18px; font-weight: 700; color: #f1f5f9; margin-bottom: 8px; }
        body[data-theme="light"] .modal-title { color: #111827; }
        .modal-text  { font-size: 14px; color: #94a3b8; margin-bottom: 24px; }
        body[data-theme="light"] .modal-text { color: #6b7280; }
        .modal-actions { display: flex; gap: 10px; justify-content: center; }
        .modal-btn { padding: 10px 26px; border-radius: 8px; border: none; font-size: 14px; font-weight: 600; cursor: pointer; transition: opacity 0.2s, transform 0.1s; }
        .modal-btn:hover { opacity: 0.88; transform: translateY(-1px); }
        .modal-btn.cancel  { background: #334155; color: #cbd5e1; }
        body[data-theme="light"] .modal-btn.cancel { background: #f3f4f6; color: #374151; }
        .modal-btn.confirm { background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; }
    </style>
</head>

<body data-theme="light">

    <header class="admin-header">

        <div class="logo">PublicityHub Panel</div>

        <!-- ? ADMIN NAV -->
        <nav class="nav-links" id="adminNav">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision">Vision</a>
            <a href="/User/Create">Create User</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ? PROVIDER NAV -->
        <nav class="nav-links" id="providerNav" style="display:none;">
            <a href="/Provider/Dashboard">Dashboard</a>
            <a href="/Campaign/Create">Create Campaign</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ? LOGOUT ONLY -->
        <nav class="nav-links" id="logoutOnly" style="display:none;">
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <div style="display:flex;align-items:center;gap:8px;">
            <span id="headerUserName" style="color:#94a3b8;font-size:13px;font-weight:500;"></span>
            <button id="themeToggle" class="theme-btn" title="Toggle theme">
                <span id="themeIcon">&#9790;</span> Mode
            </button>
            <button onclick="setLang('en')" class="lang-btn">EN</button>
            <button onclick="setLang('ta')" class="lang-btn">Tamil</button>
        </div>

    </header>

    <!-- LOGOUT CONFIRM MODAL -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-box">
            <div class="modal-icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </div>
            <div class="modal-title">Logging out?</div>
            <div class="modal-text">You'll need to sign in again to access your dashboard.</div>
            <div class="modal-actions">
                <button class="modal-btn cancel" onclick="closeLogoutModal()">Stay</button>
                <button class="modal-btn confirm" onclick="confirmLogout()">Yes, logout</button>
            </div>
        </div>
    </div>

    <!-- Apply saved theme IMMEDIATELY to prevent flash -->
    <script>
        (function() {
            const t = localStorage.getItem("theme");
            if (t) document.body.setAttribute("data-theme", t);
        })();
    </script>

    @if (TempData["Success"] != null)
    {
        <div class="success-box">@TempData["Success"]</div>
    }

    @RenderBody()

    <!-- ? API -->
    <script src="/js/api.js"></script>

    <!-- ? ROLE + NAV CONTROL -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const token = localStorage.getItem("token");

            const adminNav = document.getElementById("adminNav");
            const providerNav = document.getElementById("providerNav");
            const logoutOnly = document.getElementById("logoutOnly");

            if (!token) {
                if (adminNav) adminNav.style.display = "none";
                if (providerNav) providerNav.style.display = "none";
                if (logoutOnly) logoutOnly.style.display = "flex";
                return;
            }

            try {
                const payload = JSON.parse(atob(token.split('.')[1]));

                const role =
                    payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];

                console.log("User role:", role);

                if (role && role.toLowerCase() === "admin") {
                    adminNav.style.display = "flex";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "none";
                }
                else if (role && role.toLowerCase() === "provider") {
                    adminNav.style.display = "none";
                    providerNav.style.display = "flex";
                    logoutOnly.style.display = "none";
                }
                else {
                    adminNav.style.display = "none";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "flex";
                }

            } catch (e) {
                console.error("Token parse error", e);
                adminNav.style.display = "none";
                providerNav.style.display = "none";
                logoutOnly.style.display = "flex";
            }

        });
    </script>

    <!-- THEME -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");

            const savedTheme = localStorage.getItem("theme") || "light";
            document.body.setAttribute("data-theme", savedTheme);
            if (icon) icon.innerHTML = savedTheme === "dark" ? "&#9728;" : "&#9790;";

            // Show logged-in user name in header
            try {
                const token = localStorage.getItem("token");
                if (token) {
                    const payload = JSON.parse(atob(token.split('.')[1]));
                    const name = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"]
                              || payload["name"] || payload["unique_name"] || "";
                    const nameEl = document.getElementById("headerUserName");
                    if (nameEl && name) nameEl.innerText = name;
                }
            } catch(e) {}

            if (btn) {
                btn.addEventListener("click", function () {
                    const next = document.body.getAttribute("data-theme") === "dark" ? "light" : "dark";
                    document.body.setAttribute("data-theme", next);
                    localStorage.setItem("theme", next);
                    if (icon) icon.innerHTML = next === "dark" ? "&#9728;" : "&#9790;";
                });
            }
        });
    </script>

    <!-- ? LANGUAGE -->
    <script>
        function setLang(lang) {
            window.location.href = "/Account/SetLanguage?lang=" + lang;
        }
    </script>

    <!-- ? LOGOUT -->
    <script>
        function logout() {
            showLogoutModal();
        }

        function showLogoutModal() {
            document.getElementById("logoutModal").classList.add("show");
        }

        function closeLogoutModal() {
            document.getElementById("logoutModal").classList.remove("show");
        }

        function confirmLogout() {
            localStorage.removeItem("token");
            window.location.href = "/Account/Login";
        }
    </script>

    <!-- ? API BASE -->
    <script>
        window.API_BASE = window.location.hostname === "localhost"
            ? "https://localhost:7166"
            : "";
    </script>

    <!-- ? jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>