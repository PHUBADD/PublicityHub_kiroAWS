<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>PublicityHub Admin</title>

    <style>
        :root {
            --bg-main: #f7fafc;
            --text-main: #0f172a;
            --card-bg: #ffffff;
        }

        body[data-theme="dark"] {
            --bg-main: #020617;
            --text-main: #e5e7eb;
            --card-bg: #0f172a;
        }

        body {
            font-family: Arial, system-ui, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            margin: 0;
        }

        .admin-header {
            display: flex;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .logo {
            font-weight: 600;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 40px;
            flex-grow: 1;
        }

            .nav-links a {
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
            }

                .nav-links a.vision {
                    color: #60a5fa;
                    font-weight: 600;
                }

                .nav-links a:hover {
                    text-decoration: underline;
                }

        .theme-btn,
        .lang-btn {
            background: none;
            border: 1px solid #94a3b8;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            color: white;
            margin-left: 10px;
        }

            .theme-btn:hover,
            .lang-btn:hover {
                background: rgba(255,255,255,0.1);
            }

        /* ✅ Validation & success styles */
        .validation-message {
            color: #dc2626;
            font-size: 13px;
            display: block;
            margin-top: 4px;
        }

            .validation-message::before {
                content: "⚠️ ";
            }

        .success-box {
            background: #dcfce7;
            color: #166534;
            padding: 10px;
            border-radius: 8px;
            margin: 15px;
            font-weight: 600;
        }
    </style>
</head>

<body data-theme="light">

    <header class="admin-header">
        <div class="logo">PublicityHub Admin Panel</div>

        <nav class="nav-links">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision" class="vision">Vision</a>
            <a href="/User/Create">Create User</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <div>
            <button id="themeToggle" class="theme-btn">🌙 / ☀️</button>
            <button onclick="setLang('en')" class="lang-btn">EN</button>
            <button onclick="setLang('ta')" class="lang-btn">தமிழ்</button>
        </div>
    </header>

    <!-- ✅ Success message -->
    @if (TempData["Success"] != null)
    {
        <div class="success-box">
            @TempData["Success"]
        </div>
    }

    @RenderBody()
    <script src="/js/api.js"></script>
    <!-- ✅ Theme + Language Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Theme toggle
            const btn = document.getElementById("themeToggle");

            if (btn) {
                btn.addEventListener("click", function () {
                    const current = document.body.getAttribute("data-theme");
                    const next = current === "dark" ? "light" : "dark";
                    document.body.setAttribute("data-theme", next);
                    localStorage.setItem("theme", next);
                });
            }

            // Load saved theme
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) {
                document.body.setAttribute("data-theme", savedTheme);
            }
        });

        function setLang(lang) {
            window.location.href = "/Account/SetLanguage?lang=" + lang;
        }

    </script>
    <script>
        function logout() {
            // ✅ Remove token
            localStorage.removeItem("token");

            // ✅ Redirect to login page
            window.location.href = "/Account/Login";
        }
    </script>

    <!-- ✅ Global API Base -->
    <script>
        window.API_BASE = window.location.hostname === "localhost"
            ? "https://localhost:7166"
            : "";
    </script>
    <!-- ✅ REQUIRED: Load jQuery FIRST -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- ✅ IMPORTANT: DO NOT PUT jQuery HERE -->
    <!-- ✅ Scripts will be injected from View -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>