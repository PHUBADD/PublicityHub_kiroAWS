<!DOCTYPE html>
<html>
<head>
    <title>PublicityHub Admin</title>

    <style>
        :root {
            --bg-main: #f7fafc;
            --text-main: #0f172a;
            --card-bg: #ffffff;
        }

        body[data-theme="dark"] {
            --bg-main: #020617;
            --text-main: #e5e7eb;
            --card-bg: #0f172a;
        }

        body {
            font-family: Arial, system-ui, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            margin: 0;
        }

        .admin-header {
            display: flex;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .logo {
            font-weight: 600;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 40px;
            flex-grow: 1;
        }

            .nav-links a {
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
            }

                .nav-links a.vision {
                    color: #60a5fa;
                    font-weight: 600;
                }

                .nav-links a:hover {
                    text-decoration: underline;
                }

        .theme-btn,
        .lang-btn {
            background: none;
            border: 1px solid #94a3b8;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            color: white;
            margin-left: 10px;
        }

            .theme-btn:hover,
            .lang-btn:hover {
                background: rgba(255,255,255,0.1);
            }
    </style>
</head>

<body data-page="vision">

    <header class="admin-header">
        <div class="logo">PublicityHub Admin Panel</div>


        <nav class="nav-links">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision" class="vision">Vision</a>
            <a href="/User/Create">Create User</a>
            <a href="/Account/Logout">Logout</a>
        </nav>


        <div>
            <button id="themeToggle" class="theme-btn">🌙 / ☀️</button>
            <button onclick="setLang('en')" class="lang-btn">EN</button>
            <button onclick="setLang('ta')" class="lang-btn">தமிழ்</button>
        </div>
    </header>

    @RenderBody()

    <!-- ✅ SCRIPT MUST BE HERE -->
    <script>
        // Ensure a default theme
        if (!document.body.getAttribute("data-theme")) {
            document.body.setAttribute("data-theme", "light");
        }

        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("themeToggle");

            if (btn) {
                btn.addEventListener("click", function () {
                    const current = document.body.getAttribute("data-theme");
                    const next = current === "dark" ? "light" : "dark";
                    document.body.setAttribute("data-theme", next);
                    localStorage.setItem("theme", next);
                });
            }

            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) {
                document.body.setAttribute("data-theme", savedTheme);
            }
        });

        function setLang(lang) {
            window.location.href = "/Account/SetLanguage?lang=" + lang;
        }
    </script>

</body>
</html>