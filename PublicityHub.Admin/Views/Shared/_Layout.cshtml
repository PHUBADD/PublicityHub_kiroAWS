<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>PublicityHub Admin</title>

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --bg-main:    #f0f4f8;
            --text-main:  #0f172a;
            --text-muted: #6b7280;
            --card-bg:    #ffffff;
            --card-border:#e5e7eb;
            --input-bg:   #ffffff;
            --input-border:#d1d5db;
            --badge-gray: #f3f4f6;
        }

        body[data-theme="dark"] {
            --bg-main:    #0f172a;
            --text-main:  #f1f5f9;
            --text-muted: #94a3b8;
            --card-bg:    #1e293b;
            --card-border:#334155;
            --input-bg:   #1e293b;
            --input-border:#475569;
            --badge-gray: #334155;
        }

        body {
            font-family: 'Segoe UI', Arial, system-ui, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            transition: background 0.3s, color 0.3s;
        }

        /* ── Dark mode: campaign cards ── */
        body[data-theme="dark"] .campaign-card {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 16px rgba(0,0,0,0.3) !important;
        }

        body[data-theme="dark"] .campaign-card h3,
        body[data-theme="dark"] .campaign-card p,
        body[data-theme="dark"] .campaign-card strong {
            color: var(--text-main) !important;
        }

        body[data-theme="dark"] .status-badge.draft       { background: #374151 !important; color: #d1d5db !important; }
        body[data-theme="dark"] .status-badge.published   { background: #1e3a5f !important; color: #93c5fd !important; }
        body[data-theme="dark"] .status-badge.inexecution { background: #3b2a0a !important; color: #fcd34d !important; }
        body[data-theme="dark"] .status-badge.completed   { background: #0f3320 !important; color: #6ee7b7 !important; }
        body[data-theme="dark"] .status-badge.closed      { background: #3b0f0f !important; color: #fca5a5 !important; }

        body[data-theme="dark"] .badge.success { background: #0f3320 !important; color: #6ee7b7 !important; }
        body[data-theme="dark"] .badge.closed  { background: #3b0f0f !important; color: #fca5a5 !important; }

        body[data-theme="dark"] .btn.publish  { background: #1d4ed8 !important; }
        body[data-theme="dark"] .btn.complete { background: #15803d !important; }
        body[data-theme="dark"] .btn.close    { background: #b91c1c !important; }
        body[data-theme="dark"] .btn.assign   { background: #1d4ed8 !important; }
        body[data-theme="dark"] .btn.disabled { background: #334155 !important; color: #64748b !important; }

        body[data-theme="dark"] .proof-link { color: #60a5fa !important; }

        /* ── Dark mode: proof cards ── */
        body[data-theme="dark"] .proof-card {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
        }

        /* ── Dark mode: forms / inputs ── */
        body[data-theme="dark"] input,
        body[data-theme="dark"] textarea,
        body[data-theme="dark"] select {
            background: var(--input-bg) !important;
            color: var(--text-main) !important;
            border-color: var(--input-border) !important;
        }

        body[data-theme="dark"] .create-card,
        body[data-theme="dark"] .assign-card,
        body[data-theme="dark"] .upload-card,
        body[data-theme="dark"] .proof-form {
            background: var(--card-bg) !important;
            color: var(--text-main) !important;
        }

        body[data-theme="dark"] label,
        body[data-theme="dark"] .form-group label {
            color: var(--text-main) !important;
        }

        /* ── Dark mode: success box ── */
        body[data-theme="dark"] .success-box {
            background: #0f3320;
            color: #6ee7b7;
        }

        .admin-header {
            display: flex;
            align-items: center;
            background: #1f2937;
            padding: 15px 25px;
            color: white;
        }

        .logo {
            font-weight: 600;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 40px;
            flex-grow: 1;
        }

            .nav-links a {
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
            }

                .nav-links a:hover {
                    text-decoration: underline;
                }

        .theme-btn,
        .lang-btn {
            background: none;
            border: 1px solid #94a3b8;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            color: white;
            margin-left: 10px;
        }

            .theme-btn:hover,
            .lang-btn:hover {
                background: rgba(255,255,255,0.1);
            }

        .success-box {
            background: #dcfce7;
            color: #166534;
            padding: 10px;
            border-radius: 8px;
            margin: 15px;
            font-weight: 600;
        }
    </style>
</head>

<body data-theme="light">

    <header class="admin-header">

        <div class="logo">PublicityHub Panel</div>

        <!-- ✅ ADMIN NAV -->
        <nav class="nav-links" id="adminNav">
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Proof/Index">Proofs</a>
            <a href="/Admin/Vision">Vision</a>
            <a href="/User/Create">Create User</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ✅ PROVIDER NAV -->
        <nav class="nav-links" id="providerNav" style="display:none;">
            <a href="/Provider/Dashboard">Dashboard</a>
            <a href="/Campaign/Create">Create Campaign</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <!-- ✅ LOGOUT ONLY -->
        <nav class="nav-links" id="logoutOnly" style="display:none;">
            <a href="#" onclick="logout()">Logout</a>
        </nav>

        <div>
            <button id="themeToggle" class="theme-btn">🌙 / ☀️</button>
            <button onclick="setLang('en')" class="lang-btn">EN</button>
            <button onclick="setLang('ta')" class="lang-btn">தமிழ்</button>
        </div>

    </header>

    <!-- Apply saved theme IMMEDIATELY to prevent flash -->
    <script>
        (function() {
            const t = localStorage.getItem("theme");
            if (t) document.body.setAttribute("data-theme", t);
        })();
    </script>

    @if (TempData["Success"] != null)
    {
        <div class="success-box">@TempData["Success"]</div>
    }

    @RenderBody()

    <!-- ✅ API -->
    <script src="/js/api.js"></script>

    <!-- ✅ ROLE + NAV CONTROL -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const token = localStorage.getItem("token");

            const adminNav = document.getElementById("adminNav");
            const providerNav = document.getElementById("providerNav");
            const logoutOnly = document.getElementById("logoutOnly");

            if (!token) {
                if (adminNav) adminNav.style.display = "none";
                if (providerNav) providerNav.style.display = "none";
                if (logoutOnly) logoutOnly.style.display = "flex";
                return;
            }

            try {
                const payload = JSON.parse(atob(token.split('.')[1]));

                const role =
                    payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];

                console.log("User role:", role);

                if (role && role.toLowerCase() === "admin") {
                    adminNav.style.display = "flex";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "none";
                }
                else if (role && role.toLowerCase() === "provider") {
                    adminNav.style.display = "none";
                    providerNav.style.display = "flex";
                    logoutOnly.style.display = "none";
                }
                else {
                    adminNav.style.display = "none";
                    providerNav.style.display = "none";
                    logoutOnly.style.display = "flex";
                }

            } catch (e) {
                console.error("Token parse error", e);
                adminNav.style.display = "none";
                providerNav.style.display = "none";
                logoutOnly.style.display = "flex";
            }

        });
    </script>

    <!-- ✅ THEME -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const btn = document.getElementById("themeToggle");

            if (btn) {
                btn.addEventListener("click", function () {
                    const current = document.body.getAttribute("data-theme");
                    const next = current === "dark" ? "light" : "dark";

                    document.body.setAttribute("data-theme", next);
                    localStorage.setItem("theme", next);
                });
            }

            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) {
                document.body.setAttribute("data-theme", savedTheme);
            }
        });
    </script>

    <!-- ✅ LANGUAGE -->
    <script>
        function setLang(lang) {
            window.location.href = "/Account/SetLanguage?lang=" + lang;
        }
    </script>

    <!-- ✅ LOGOUT -->
    <script>
        function logout() {
            localStorage.removeItem("token");
            window.location.href = "/Account/Login";
        }
    </script>

    <!-- ✅ API BASE -->
    <script>
        window.API_BASE = window.location.hostname === "localhost"
            ? "https://localhost:7166"
            : "";
    </script>

    <!-- ✅ jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>