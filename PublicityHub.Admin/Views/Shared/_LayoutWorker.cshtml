<!DOCTYPE html>
<html>
<head>
    <title>PublicityHub</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f3f4f6;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #111827;
            color: white;
            padding: 12px 20px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
        }

        a.logout {
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

            a.logout:hover {
                text-decoration: underline;
            }
    </style>
</head>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const logoutBtn = document.getElementById("logoutBtn");

        if (logoutBtn) {
            logoutBtn.addEventListener("click", function (e) {
                e.preventDefault();

                // ✅ Remove token
                localStorage.removeItem("token");

                console.log("✅ Token cleared");

                // ✅ Force redirect
                window.location.href = "/Account/Login";
            });
        }

    });
</script>

<body>

    <!-- ✅ Top bar -->
    <div class="navbar">
        <div><strong>PublicityHub</strong></div>

        <div>
        @*<a href="/Account/Logout" class="logout">Logout</a>*@  

<a href="#" id="logoutBtn">Logout</a>
</div>
    </div>

    <!-- ✅ Main content -->
    <div class="container">
        @RenderBody()
    </div>
    <script src="/js/api.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const token = localStorage.getItem("token");

            console.log("Checking token on Worker page:", token);

            // ✅ Strong validation
            if (!token || token === "null" || token === "undefined" || token.trim() === "") {
                console.log("❌ Invalid token → redirect");
                window.location.href = "/Account/Login";
                return;
            }

            // ✅ OPTIONAL: decode token to check role (simple method)
            try {
                const payload = JSON.parse(atob(token.split('.')[1]));
                console.log("Token payload:", payload);

                const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];

                if (!role || role.toLowerCase() !== "worker") {
                    console.log("❌ Not a worker → redirect");
                    window.location.href = "/Account/Login";
                    return;
                }

                console.log("✅ Worker verified → stay");

            } catch (e) {
                console.log("❌ Token decode failed → redirect");
                window.location.href = "/Account/Login";
            }

        });
    </script>
   

</body>
</html>