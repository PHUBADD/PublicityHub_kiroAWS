@model PublicityHub.Admin.Models.CreateUserViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
}

<h2 class="page-title">Create User</h2>

<div class="form-card">

    <!-- ✅ Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="error-summary"></div>

    <form method="post">

        <div class="form-group">
            <label>Full Name</label>
            <input asp-for="FullName" placeholder="Enter full name" />
            <span asp-validation-for="FullName" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber"
                   placeholder="Enter phone number"
                   maxlength="10"
                   onkeypress="return onlyNumbers(event)" />
            <span asp-validation-for="PhoneNumber" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Role</label>
            <select asp-for="Role">
                <option value="">-- Select Role --</option>
                <option value="admin">Admin</option>
                <option value="worker">Worker</option>
                <option value="provider">Provider</option>
            </select>
            <span asp-validation-for="Role" class="validation-message"></span>
        </div>

        <button type="submit"
                id="submitBtn"
                class="btn primary"                
                disabled>
            Create User
        </button>

    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector("form");
            const submitBtn = document.getElementById("submitBtn");

            function checkValidity() {
                submitBtn.disabled = !form.checkValidity();
            }

            form.addEventListener("input", checkValidity);

            // ✅ ONLY trigger loading when form is valid and submitting
            form.addEventListener("submit", function () {

                if (form.checkValidity()) {
                    submitBtn.classList.add("loading");
                    submitBtn.innerText = "Creating...";
                }
            });

            checkValidity();
        });
    </script>
    <script>
        function setLoading(btn) {
            btn.classList.add("loading");
            btn.innerText = "Creating...";
        }

        function onlyNumbers(evt) {
            var charCode = evt.which ? evt.which : evt.keyCode;
            if (charCode < 48 || charCode > 57) return false;
            return true;
        }

        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector("form");
            const submitBtn = document.getElementById("submitBtn");

            function checkValidity() {
                submitBtn.disabled = !form.checkValidity();
            }

            form.addEventListener("input", checkValidity);
            checkValidity();
        });
    </script>
}

<style>
    button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* ✅ Validation icon style */
    .validation-message {
        color: #dc2626;
        font-size: 13px;
        display: block;
        margin-top: 4px;
    }

        .validation-message::before {
            content: "⚠️ ";
        }

    /* ✅ Card */
    .form-card {
        animation: fadeIn 0.4s ease-in;
        max-width: 420px;
        background: #fff;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    /* ✅ Inputs */
    .form-group {
        margin-bottom: 16px;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
    }

        input:focus, select:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

    /* ✅ Button */
    .btn.primary {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        background: #2563eb;
        color: white;
        border: none;
        cursor: pointer;
    }

    /* ✅ Loading animation */
    .btn.loading {
        pointer-events: none;
        opacity: 0.8;
    }

        .btn.loading::after {
            content: "";
            width: 14px;
            height: 14px;
            border: 2px solid white;
            border-top-color: transparent;
            border-radius: 50%;
            margin-left: 8px;
            display: inline-block;
            animation: spin 0.8s linear infinite;
        }

    /* ✅ Summary error */
    .error-summary {
        background: #fee2e2;
        color: #991b1b;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 12px;
    }

    .page-title {
        margin-bottom: 18px;
    }

    /* ✅ Animations */

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }


    
</style>
