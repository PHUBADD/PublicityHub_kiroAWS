@using PublicityHub.Admin.Models
@model List<WorkerAssignmentViewModel>

@{
    Layout = "_LayoutWorker";
}

<h2 class="page-title">My Jobs</h2>

<div id="jobsContainer"></div>
<div id="toast" class="toast"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("jobsContainer");

        const token = localStorage.getItem("token");
        if (!token) {
            container.innerHTML = "<p>❌ Not logged in. Please <a href='/Auth/Login'>login</a>.</p>";
            return;
        }

        const payload = JSON.parse(atob(token.split('.')[1]));
        const workerId = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"];

        if (!workerId) {
            container.innerHTML = "<p>❌ Worker ID not found in token.</p>";
            return;
        }

        // ✅ apiFetch handles local vs production automatically
        apiFetch(`/api/jobassignments/worker/${workerId}`, {
            method: "GET",
            headers: { "Content-Type": "application/json" }
        })
            .then(res => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then(jobs => {
                if (!jobs || jobs.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <h3>No jobs assigned yet</h3>
                            <p>🕒 Please wait. New tasks will appear here soon.</p>
                        </div>
                    `;
                    return;
                }

                let html = `<div class="worker-grid">`;
                jobs.forEach(job => {
                    html += `
                    <div class="worker-card ${job.status.toLowerCase()}">
                        <h3>${job.campaignTitle}</h3>
                        <p>💰 Payment: ₹${job.amount}</p>
                        <p>📍 Location: ${job.location}</p>

                        <span class="status-badge ${job.status.toLowerCase()}">
                            ${job.status}
                        </span>

                        <div class="progress-bar">
                            <div class="step ${job.status === "Available" ? "active" : ""}">Assigned</div>
                            <div class="step ${job.status === "Accepted" ? "active" : ""}">Accepted</div>
                            <div class="step ${job.status === "ProofSubmitted" ? "active" : ""}">Submitted</div>
                            <div class="step ${job.status === "Approved" ? "active" : ""}">Approved</div>
                        </div>

                        <div class="actions">
                            ${renderActions(job)}
                        </div>
                    </div>
                    `;
                });
                html += `</div>`;
                container.innerHTML = html;
            })
            .catch(err => {
                container.innerHTML = `<p>❌ Failed to load jobs: ${err.message}</p>`;
                console.error(err);
            });
    });

    function renderActions(job) {
        if (job.status === "Available") {
            return `
                    <p class="hint">👉 Accept this job to begin work</p>
                    <button class="btn primary" onclick="accept(${job.assignmentId}, this)">Accept Job</button>
                `;
        }
        if (job.status === "Accepted") {
            return `
                    <p class="hint">✅ Complete and upload proof</p>
                    <button class="btn success" onclick="complete(${job.assignmentId}, this)">Mark Completed</button>
                `;
        }
        if (job.status === "ProofSubmitted") {
            return `
                    <p class="hint">📤 Waiting for admin approval</p>
                    <span class="success-text">Submitted ✅</span>
                `;
        }
        if (job.status === "Approved") {
            return `
                    <p class="hint">🎉 Approved</p>
                    <span class="success-text">Approved ✅</span>
                `;
        }
        return "";
    }

    function accept(id, btn) {
        btn.disabled = true;
        btn.innerText = "Processing...";

        // ✅ apiFetch — works on localhost and render.com
        apiFetch(`/api/jobassignments/${id}/accept`, { method: "POST" })
            .then(res => {
                if (!res.ok) throw new Error("Failed to accept");
                showToast("✅ Job Accepted");
                setTimeout(() => location.reload(), 800);
            })
            .catch(err => {
                alert("❌ " + err.message);
                btn.disabled = false;
                btn.innerText = "Accept Job";
            });
    }

    function complete(id, btn) {
        window.location.href = `/Worker/UploadProof/${id}`;
    }

    function showToast(message) {
        const toast = document.getElementById("toast");
        toast.innerText = message;
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 2500);
    }
</script>



<style>
    .worker-card {
        padding: 16px;
    }

        .worker-card p {
            margin: 4px 0;
        }

    .hint {
        font-size: 13px;
        color: #6b7280;
    }

    .progress-bar {
        display: flex;
        gap: 8px;
        margin: 10px 0;
    }

    .step {
        flex: 1;
        padding: 4px;
        font-size: 12px;
        text-align: center;
        background: #e5e7eb;
        border-radius: 6px;
    }

        .step.active {
            background: #2563eb;
            color: white;
        }
    .toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #16a34a;
        color: white;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 9999;
    }

        .toast.show {
            opacity: 1;
        }

    .page-title {
        margin-bottom: 20px;
    }

    .empty-text {
        color: #6b7280;
    }

    .worker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
    }


.worker-card {
    padding: 18px;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    transition: transform 0.2s ease;
    border-left: 6px solid transparent;
}

/* ✅ STATUS COLORS FOR CARDS */
.worker-card.available {
    background: #f0f9ff;
    border-left-color: #2563eb;
}

.worker-card.accepted {
    background: #fffbeb;
    border-left-color: #f59e0b;
}

.worker-card.proofsubmitted {
    background: #f5f3ff;
    border-left-color: #7c3aed;
}

.worker-card.approved {
    background: #ecfdf5;
    border-left-color: #16a34a;
}

/* ✅ Hover effect */
.worker-card:hover {
    transform: translateY(-4px);
}


    .status-badge {
        display: inline-block;
        margin: 8px 0;
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .status-badge.available {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-badge.accepted {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.proofsubmitted {
            background: #ede9fe;
            color: #5b21b6;
        }

        .status-badge.approved {
            background: #dcfce7;
            color: #166534;
        }

    .actions {
        margin-top: 10px;
    }

    .btn {
        padding: 8px 14px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
    }

        .btn.primary {
            background: #2563eb;
            color: white;
        }

        .btn.success {
            background: #16a34a;
            color: white;
        }

    .hint {
        font-size: 13px;
        color: #6b7280;
    }

    .success-text {
        color: #16a34a;
        font-weight: 600;
    }
</style>