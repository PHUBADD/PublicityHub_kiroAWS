@using PublicityHub.Admin.Models
@model List<WorkerAssignmentViewModel>

@{
    Layout = "_LayoutWorker";
}

<h2 class="page-title">My Jobs</h2>

<div id="jobsContainer"></div>
<div id="toast" class="toast"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("jobsContainer");

        const token = localStorage.getItem("token");
        if (!token) {
            container.innerHTML = "<p>Not logged in. Please <a href='/Account/Login'>login</a>.</p>";
            return;
        }

        const payload = JSON.parse(atob(token.split('.')[1]));
        const workerId = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"];

        if (!workerId) {
            container.innerHTML = "<p>Worker ID not found in token.</p>";
            return;
        }

        apiFetch(`/api/jobassignments/worker/${workerId}`)
            .then(res => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then(jobs => {
                if (!jobs || jobs.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <div style="font-size:48px;margin-bottom:12px;">📋</div>
                            <h3>No jobs assigned yet</h3>
                            <p>Please wait. New tasks will appear here soon.</p>
                        </div>`;
                    return;
                }

                let html = `<div class="worker-grid">`;
                jobs.forEach(job => {
                    const s = job.status.toLowerCase();

                    // Progress steps — mark done/active
                    const steps = [
                        { label: "Assigned",  states: ["available","accepted","proofsubmitted","approved"] },
                        { label: "Accepted",  states: ["accepted","proofsubmitted","approved"] },
                        { label: "Submitted", states: ["proofsubmitted","approved"] },
                        { label: "Approved",  states: ["approved"] }
                    ];

                    const progressHtml = steps.map(step => {
                        const isDone   = step.states.includes(s);
                        const isActive = step.label.toLowerCase().replace("submitted","proofsubmitted") === s
                                      || (step.label === "Submitted" && s === "proofsubmitted")
                                      || (step.label === "Assigned"  && s === "available")
                                      || (step.label === "Accepted"  && s === "accepted")
                                      || (step.label === "Approved"  && s === "approved");
                        const cls = isActive ? "step active" : isDone ? "step done" : "step";
                        return `<div class="${cls}">${step.label}</div>`;
                    }).join("");

                    html += `
                    <div class="worker-card ${s}">
                        <h3>${job.campaignTitle ?? "Campaign"}</h3>
                        <p>💰 Payment: ₹${job.amount}</p>
                        <p>📍 Location: ${job.location ?? "—"}</p>

                        <span class="status-badge ${s}">${job.status}</span>

                        <div class="progress-bar">${progressHtml}</div>

                        <div class="actions">${renderActions(job)}</div>
                    </div>`;
                });
                html += `</div>`;
                container.innerHTML = html;
            })
            .catch(err => {
                container.innerHTML = `<p style="color:#ef4444">Failed to load jobs: ${err.message}</p>`;
            });
    });

    function renderActions(job) {
        if (job.status === "Available") {
            return `<p class="hint">👉 Accept this job to begin work</p>
                    <button class="btn primary" onclick="accept(${job.assignmentId}, this)">Accept Job</button>`;
        }
        if (job.status === "Accepted") {
            return `<p class="hint">📸 Complete work and upload proof</p>
                    <button class="btn success" onclick="goUpload(${job.assignmentId})">Upload Proof</button>`;
        }
        if (job.status === "ProofSubmitted") {
            return `<p class="hint">📤 Waiting for admin approval</p>
                    <span class="success-text">Submitted ✅</span>`;
        }
        if (job.status === "Approved") {
            return `<p class="hint">🎉 Work approved</p>
                    <span class="success-text">Approved ✅</span>`;
        }
        return "";
    }

    function accept(id, btn) {
        btn.disabled = true;
        btn.innerText = "Processing...";

        apiFetch(`/api/jobassignments/${id}/accept`, { method: "POST" })
            .then(res => {
                if (!res.ok) throw new Error("Failed to accept");
                showToast("✅ Job Accepted!");
                setTimeout(() => location.reload(), 900);
            })
            .catch(err => {
                alert("❌ " + err.message);
                btn.disabled = false;
                btn.innerText = "Accept Job";
            });
    }

    function goUpload(id) {
        window.location.href = `/Worker/UploadProof/${id}`;
    }

    function showToast(message) {
        const toast = document.getElementById("toast");
        toast.innerText = message;
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 2500);
    }
</script>
