@using PublicityHub.Admin.Models
@model List<WorkerAssignmentViewModel>

@{
    Layout = "_Layout";
}

<h2 class="page-title">My Jobs</h2>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>No jobs assigned yet</h3>
        <p>🕒 Please wait. New tasks will appear here soon.</p>
    </div>
}
else
{
    <div class="worker-grid">

        @foreach (var job in Model)
        {
            <div class="worker-card">

                <h3>@job.CampaignTitle</h3>

                <p>💰 Payment: ₹@job.Amount</p>
                <p>📍 Location: @job.Location</p>

                <!-- ✅ Status -->
                <span class="status-badge @job.Status.ToLower()">
                    @job.Status
                </span>

                <!-- ✅ Progress -->
                <div class="progress-bar">
                    <div class="step @(job.Status == "Available" ? "active" : "")">Assigned</div>
                    <div class="step @(job.Status == "Accepted" ? "active" : "")">Accepted</div>
                    <div class="step @(job.Status == "ProofSubmitted" ? "active" : "")">Submitted</div>
                    <div class="step @(job.Status == "Approved" ? "active" : "")">Approved</div>
                </div>

                <!-- ✅ Actions -->
                <div class="actions">

                    @if (job.Status == "Available")
                    {
                        <p class="hint">👉 Accept this job to begin work</p>

                        <button class="btn primary"
                                onclick="accept(@job.AssignmentId, this)">
                            Accept Job
                        </button>
                    }
                    else if (job.Status == "Accepted")
                    {
                        <p class="hint">✅ Complete the job and upload proof</p>

                        <button class="btn success"
                                onclick="complete(@job.AssignmentId, this)">
                            Mark as Completed
                        </button>
                    }
                    else if (job.Status == "ProofSubmitted")
                    {
                        <p class="hint">📤 Proof submitted. Waiting for approval</p>

                        <span class="success-text">Submitted ✅</span>
                    }
                    else if (job.Status == "Approved")
                    {
                        <p class="hint">🎉 Job approved. Great work!</p>

                        <span class="success-text">Approved ✅</span>
                    }

                </div>

            </div>
        }

    </div>

    <div id="toast" class="toast"></div>
}

<script>
    function showToast(message) {
        const toast = document.getElementById("toast");
        toast.innerText = message;
        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 2500);
    }

    function disableButton(btn) {
        btn.disabled = true;
        btn.innerText = "Processing...";
        btn.style.opacity = "0.6";
    }

        function accept(id, btn) {
        btn.disabled = true;
        btn.innerText = "Processing...";

        fetch(`${window.API_BASE}/api/jobassignments/${id}/accept`, {
            method: "POST"
        })

    .then(res => {
        if (!res.ok) throw new Error("Request failed");

        // ✅ handle both cases (JSON or empty)
        return res.headers.get("content-length") !== "0"
            ? res.json()
            : null;
    })

        .then(() => {
            alert("✅ Success");
            location.reload();
        })
        .catch(err => {
            alert("❌ " + err.message);
            btn.disabled = false;
            btn.innerText = "Accept Job";
        });
    }

    function complete(id, btn) {
        disableButton(btn);

        // ✅ FIXED (use API_BASE consistently)
        fetch(`${window.API_BASE}/api/jobassignments/${id}/complete`, {
            method: "POST"
        }).then(() => {
            window.location.href = `/Worker/UploadProof/${id}`;
        });
    }
</script>

<style>
    .worker-card {
        padding: 16px;
    }

        .worker-card p {
            margin: 4px 0;
        }

    .hint {
        font-size: 13px;
        color: #6b7280;
    }

    ``
    .progress-bar {
        display: flex;
        gap: 8px;
        margin: 10px 0;
    }

    .step {
        flex: 1;
        padding: 4px;
        font-size: 12px;
        text-align: center;
        background: #e5e7eb;
        border-radius: 6px;
    }

        .step.active {
            background: #2563eb;
            color: white;
        }
    .toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #16a34a;
        color: white;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 9999;
    }

        .toast.show {
            opacity: 1;
        }

    .page-title {
        margin-bottom: 20px;
    }

    .empty-text {
        color: #6b7280;
    }

    .worker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
    }

    .worker-card {
        background: #fff;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    .status-badge {
        display: inline-block;
        margin: 8px 0;
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .status-badge.available {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-badge.accepted {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.proofsubmitted {
            background: #ede9fe;
            color: #5b21b6;
        }

        .status-badge.approved {
            background: #dcfce7;
            color: #166534;
        }

    .actions {
        margin-top: 10px;
    }

    .btn {
        padding: 8px 14px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
    }

        .btn.primary {
            background: #2563eb;
            color: white;
        }

        .btn.success {
            background: #16a34a;
            color: white;
        }

    .hint {
        font-size: 13px;
        color: #6b7280;
    }

    .success-text {
        color: #16a34a;
        font-weight: 600;
    }
</style>