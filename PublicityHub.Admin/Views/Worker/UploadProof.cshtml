@{
    Layout = "_Layout";
}

<h2>Upload Proof</h2>

<div class="proof-form">
    <label>Image URL</label>
    <input type="text" id="imageUrl" placeholder="Paste image URL here" />

    <button class="btn submit" onclick="uploadProof()">
        Submit Proof
    </button>
</div>

<script>
    function uploadProof() {
        const imageUrl = document.getElementById("imageUrl").value;
        const assignmentId = @ViewBag.AssignmentId;

        fetch(`https://localhost:7166/api/proofs`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                assignmentId: assignmentId,
                imageUrl: imageUrl
            })
        }).then(() => {
            alert("Proof submitted successfully");
            window.location.href = "/Worker/Dashboard";
        });
    }
</script>

<style>
    .proof-form {
        max-width: 400px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        .proof-form input {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            margin-bottom: 16px;
        }

    .btn.submit {
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>