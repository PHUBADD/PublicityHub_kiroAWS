@{
    Layout = "_Layout";
}

<h2>Upload Proof</h2>

<div class="proof-form">
    <label>Image URL</label>
    <input type="text" id="imageUrl" placeholder="Paste image URL here" />

    <button class="btn submit" onclick="uploadProof(this)">
        Submit Proof
    </button>
</div>


<script>
    const API_BASE = "https://localhost:7166";

    function uploadProof(btn) {
        const imageUrl = document.getElementById("imageUrl").value;
        const assignmentId = @ViewBag.AssignmentId;

        if (!imageUrl || !imageUrl.startsWith("http")) {
            alert("Please enter a valid image URL");
            return;
        }

        btn.disabled = true;
        btn.innerText = "Uploading...";

        fetch(`${API_BASE}/api/Proofs`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                assignmentId: assignmentId,
                imageUrl: imageUrl,
                latitude: 0,
                longitude: 0

            })
        })
        .then(r => {
            if (!r.ok) throw new Error("Upload failed");
            alert("✅ Proof uploaded successfully");
            window.location.href = "/Worker/Dashboard";
        })
        .catch(err => {
            alert(err.message);
            btn.disabled = false;
            btn.innerText = "Submit Proof";
        });
    }
</script>


<style>
    .proof-form {
        max-width: 400px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        .proof-form input {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            margin-bottom: 16px;
        }

    .btn.submit {
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>