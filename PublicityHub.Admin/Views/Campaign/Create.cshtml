@model CreateCampaignViewModel
@{
    Layout = "_Layout";
}

<div class="create-container">
    <div class="create-card">
        <h2 class="title">🚀 Create New Campaign</h2>
        <p class="subtitle">
            Fill in the details to launch a new campaign
        </p>

        <form method="post" class="create-form">
            <div class="form-group">
                <label>Campaign Title</label>
                <input asp-for="Title" placeholder="Enter campaign title" required />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Description"
                          placeholder="Describe the campaign"
                          rows="3"
                          required></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Location</label>
                    <input asp-for="Location" placeholder="City / Area" required />
                </div>

                <div class="form-group">
                    <label>Amount (₹)</label>
                    <input asp-for="Amount"
                           type="number"
                           placeholder="Budget"
                           required />
                </div>
            </div>

            <!-- Hidden Admin ID (temporary) -->
            <input type="hidden" asp-for="CreatedBy" />

            <button type="submit" class="btn-create">
                ✅ Create Campaign
            </button>
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" id="roleField" name="Role" />

        </form>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const token = localStorage.getItem("token");

        if (!token) return;

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));

            const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];
            const userId = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"];

            document.getElementById("roleField").value = role;

            const createdByField = document.querySelector("[name='CreatedBy']");
            if (createdByField) {
                createdByField.value = userId;
            }

        } catch (e) {
            console.error(e);
        }
    });
</script>
``

<style>
    .create-container {
        display: flex;
        justify-content: center;
        margin-top: 40px;
    }

    .create-card {
        width: 100%;
        max-width: 520px;
        background: linear-gradient(135deg, #ffffff, #f9fafb);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .title {
        margin-bottom: 6px;
        color: #111827;
        font-size: 24px;
    }

    .subtitle {
        margin-bottom: 24px;
        color: #6b7280;
        font-size: 14px;
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #374151;
        }

        .form-group input,
        .form-group textarea {
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            font-size: 14px;
            transition: border 0.2s, box-shadow 0.2s;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: #2563eb;
                box-shadow: 0 0 0 2px rgba(37,99,235,0.15);
            }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .btn-create {
        margin-top: 10px;
        padding: 12px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .btn-create:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(37,99,235,0.35);
        }
</style>
