
@using PublicityHub.Admin.Models
@model List<CampaignViewModel>

@{
    Layout = "_Layout";
}

<h2 class="provider-title">🌿 Provider Campaign Dashboard</h2>

<a href="/Campaign/Create" class="btn primary">
    ➕ Create Campaign
</a>

<!-- ✅ ALWAYS KEEP THIS -->
<p class="empty" id="emptyMessage">No campaigns created yet.</p>

<!-- ✅ ALWAYS KEEP THIS (VERY IMPORTANT) -->
<div class="campaign-grid" id="campaignContainer">

    @* Optional fallback rendering *@
    @if (Model != null && Model.Any())
    {
        foreach (var c in Model)
        {
            <div class="campaign-card">
                <h3>@c.Title</h3>

                <p><strong>Status:</strong> @c.Status</p>
                <p><strong>Amount:</strong> ₹@c.Amount</p>

                <p class="creator">👤 @c.CreatedByName</p>

                <div class="actions">
                    @if (c.Status == "Draft")
                    {
                        <button onclick="publish(@c.Id, this)">Publish</button>
                    }

                    @if (c.Status == "Draft" || c.Status == "Published")
                    {
                        <button onclick="closeCampaign(@c.Id, this)">Close</button>
                    }
                </div>
            </div>
        }
    }

</div>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const token = localStorage.getItem("token");

    if (!token) {
        console.error("No token found");
        return;
    }

    try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        const userId = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"];

        console.log("UserId:", userId);

        loadProviderCampaigns(userId);

    } catch (e) {
        console.error("Token parse error:", e);
    }
});


function loadProviderCampaigns(userId) {

    apiFetch(`/api/Campaigns/by-user?userId=${userId}`)
        .then(res => res.json())
        .then(data => {

            console.log("API DATA:", data);

            const container = document.getElementById("campaignContainer");
            const emptyMsg = document.getElementById("emptyMessage");

            if (!container) {
                console.error("Container not found!");
                return;
            }

            // ✅ hide default message
            if (emptyMsg) emptyMsg.style.display = "none";

            container.innerHTML = "";

            if (!data || !data.length) {
                container.innerHTML = "<p class='empty'>No campaigns created yet.</p>";
                return;
            }

            data.forEach(c => {

                let actions = "";

                if (c.status === "Draft") {
                    actions += `<button onclick="publish(${c.id}, this)">Publish</button>`;
                }

                if (c.status === "Draft" || c.status === "Published") {
                    actions += `<button onclick="closeCampaign(${c.id}, this)">Close</button>`;
                }

                container.innerHTML += `
                    <div class="campaign-card">
                        <h3>${c.title}</h3>
                        <p><strong>Status:</strong> ${c.status}</p>
                        <p><strong>Amount:</strong> ₹${c.amount}</p>
                        <p class="creator">👤 ${c.createdByName}</p>
                        <div class="actions">${actions}</div>
                    </div>
                `;
            });

        })
        .catch(err => {
            console.error("API ERROR:", err);
            alert("Error loading campaigns");
        });
}


// ✅ existing functions
function disable(btn) {
    btn.disabled = true;
    btn.innerText = "Processing...";
}

function publish(id, btn) {
    disable(btn);

    apiFetch(`/api/Campaigns/${id}/publish`, { method: "POST" })
        .then(() => {
            alert("✅ Campaign published");
            location.reload();
        });
}

function closeCampaign(id, btn) {
    disable(btn);

    apiFetch(`/api/Campaigns/${id}/close`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            closedBy: 1,
            reason: "Closed by provider"
        })
    }).then(() => {
        alert("🚫 Campaign closed");
        location.reload();
    });
}
</script>


<style>
    .provider-title {
        color: #059669;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .empty {
        color: gray;
        margin-top: 20px;
    }

    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .campaign-card {
        background: white;
        padding: 18px;
        border-radius: 12px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.08);
    }

        .campaign-card h3 {
            margin-bottom: 6px;
        }

    .creator {
        color: #6b7280;
        font-size: 13px;
    }

    .actions {
        margin-top: 10px;
        display: flex;
        gap: 8px;
    }

    button {
        padding: 6px 10px;
        border: none;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }


    body {
        animation: bgChange 12s infinite alternate;
    }

@@keyframes bgChange {
        0%

    {
        background: #f0f9ff;
    }

    25% {
        background: #ecfdf5;
    }

    50% {
        background: #fef3c7;
    }

    75% {
        background: #f5f3ff;
    }

    100% {
        background: #fff7ed;
    }

    }

    .provider-title {
        color: #059669;
        margin-bottom: 15px;
    }

    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 15px;
    }
    </style>
