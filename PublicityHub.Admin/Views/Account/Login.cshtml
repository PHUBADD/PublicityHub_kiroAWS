@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login – PublicityHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        /* ============================================
           RESET & BASE
        ============================================ */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #0a0f1e;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* ============================================
           ANIMATED BACKGROUND CANVAS
        ============================================ */
        #bgCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        /* ============================================
           FLOATING LABELS (city names / campaign words)
        ============================================ */
        .floating-words {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
        }

        .word {
            position: absolute;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(96, 165, 250, 0.18);
            animation: floatUp linear infinite;
            white-space: nowrap;
        }

        @@keyframes floatUp {
            0%   { transform: translateY(110vh) rotate(-6deg); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 0.6; }
            100% { transform: translateY(-10vh) rotate(6deg); opacity: 0; }
        }

        /* ============================================
           PIN DROP MARKERS (background decoration)
        ============================================ */
        .pin {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            animation: pinPulse 3s ease-in-out infinite;
            z-index: 1;
        }

        @@keyframes pinPulse {
            0%, 100% { transform: rotate(-45deg) scale(1); opacity: 0.4; }
            50%       { transform: rotate(-45deg) scale(1.5); opacity: 0.9; }
        }

        /* ============================================
           CARD WRAPPER — centered
        ============================================ */
        .login-scene {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
            padding: 20px;
            animation: cardEnter 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @@keyframes cardEnter {
            from { opacity: 0; transform: translateY(40px) scale(0.94); }
            to   { opacity: 1; transform: translateY(0)    scale(1); }
        }

        /* ============================================
           GLASS CARD
        ============================================ */
        .login-card {
            background: rgba(15, 23, 42, 0.82);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(96, 165, 250, 0.18);
            border-radius: 20px;
            padding: 44px 40px 36px;
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.04),
                0 32px 64px rgba(0,0,0,0.6),
                0 0 80px rgba(37, 99, 235, 0.12);
            text-align: center;
        }

        /* Logo mark */
        .logo-mark {
            width: 64px;
            height: 64px;
            margin: 0 auto 18px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
            animation: logoBounce 2.5s ease-in-out infinite;
        }

        @@keyframes logoBounce {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-6px); }
        }

        .login-title {
            font-size: 26px;
            font-weight: 800;
            color: #f1f5f9;
            letter-spacing: -0.3px;
            margin-bottom: 4px;
        }

        .login-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 6px;
            line-height: 1.5;
        }

        .login-slogan {
            font-size: 12px;
            color: #22d3ee;
            font-style: italic;
            margin-bottom: 28px;
            opacity: 0.8;
        }

        /* ============================================
           INPUT
        ============================================ */
        .input-group {
            position: relative;
            margin-bottom: 16px;
            text-align: left;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            pointer-events: none;
        }

        .input-group input {
            width: 100%;
            padding: 14px 14px 14px 42px;
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(96, 165, 250, 0.2);
            border-radius: 10px;
            font-size: 15px;
            color: #f1f5f9;
            outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        .input-group input::placeholder { color: #475569; }

        .input-group input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        /* ============================================
           LOGIN BUTTON
        ============================================ */
        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform 0.15s, box-shadow 0.15s;
            margin-top: 6px;
            letter-spacing: 0.3px;
        }

        .btn-login::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.45);
        }
        .btn-login:hover::before { opacity: 1; }
        .btn-login:active { transform: translateY(0); }

        /* Ripple shimmer on button */
        .btn-login .shimmer {
            position: absolute;
            top: 0; left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.15), transparent);
            animation: btnShimmer 2.5s linear infinite;
        }

        @@keyframes btnShimmer {
            0%   { left: -100%; }
            100% { left: 200%; }
        }

        /* Loading state */
        .btn-login.loading {
            pointer-events: none;
            opacity: 0.75;
        }

        .btn-login.loading::after {
            content: "";
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.5);
            border-top-color: #fff;
            border-radius: 50%;
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            animation: spin 0.7s linear infinite;
        }

        @@keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }

        /* ============================================
           ERROR / SUCCESS
        ============================================ */
        .alert-box {
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 14px;
            font-size: 13px;
            font-weight: 600;
            text-align: left;
            display: none;
        }
        .alert-box.error   { background: rgba(239,68,68,0.15); color: #fca5a5; border: 1px solid rgba(239,68,68,0.3); display: block; }
        .alert-box.success { background: rgba(34,197,94,0.12); color: #86efac; border: 1px solid rgba(34,197,94,0.25); display: block; }

        /* ============================================
           FOOTER LINK
        ============================================ */
        .card-footer {
            margin-top: 22px;
            font-size: 13px;
            color: #475569;
        }

        .card-footer a {
            color: #60a5fa;
            text-decoration: none;
            font-weight: 600;
        }
        .card-footer a:hover { text-decoration: underline; }

        /* ============================================
           LOGOUT MODAL
        ============================================ */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.show { display: flex; }

        .modal-box {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 32px 36px;
            max-width: 360px;
            width: 90%;
            text-align: center;
            box-shadow: 0 24px 48px rgba(0,0,0,0.5);
            animation: modalIn 0.25s ease both;
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.9) translateY(10px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-icon { font-size: 40px; margin-bottom: 14px; }
        .modal-title { font-size: 18px; font-weight: 700; color: #f1f5f9; margin-bottom: 8px; }
        .modal-text  { font-size: 14px; color: #94a3b8; margin-bottom: 24px; }
        .modal-actions { display: flex; gap: 10px; justify-content: center; }

        .modal-btn {
            padding: 10px 26px;
            border-radius: 8px;
            border: none;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }
        .modal-btn:hover { opacity: 0.88; transform: translateY(-1px); }
        .modal-btn.cancel  { background: #334155; color: #cbd5e1; }
        .modal-btn.confirm { background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; }
    </style>
</head>

<body>

<!-- ============================================
     ANIMATED CANVAS BACKGROUND
============================================ -->
<canvas id="bgCanvas"></canvas>

<!-- Floating campaign-related words -->
<div class="floating-words" id="floatingWords"></div>

<!-- Animated pin drop markers -->
<div id="pinContainer"></div>

<!-- ============================================
     LOGIN CARD
============================================ -->
<div class="login-scene">
    <div class="login-card">

        <div class="logo-mark">??</div>

        <div class="login-title">PublicityHub</div>
        <div class="login-subtitle">Field Campaign Management Platform</div>
        <div class="login-slogan">????????? ????????? ?????????? ??????????? ????????</div>

        <div id="alertBox" class="alert-box"></div>

        <form id="loginForm" autocomplete="off">
            <div class="input-group">
                <span class="input-icon">??</span>
                <input type="text"
                       name="phoneNumber"
                       id="phoneInput"
                       placeholder="Enter your phone number"
                       maxlength="10"
                       required />
            </div>

            <button type="submit" class="btn-login" id="loginBtn">
                <span class="shimmer"></span>
                <span id="btnText">Login</span>
            </button>
        </form>

        <div class="card-footer">
            New user? <a href="/User/Create">Create account</a>
        </div>
    </div>
</div>

<!-- ============================================
     LOGOUT CONFIRM MODAL (reusable across pages)
============================================ -->
<div class="modal-overlay" id="logoutModal">
    <div class="modal-box">
        <div class="modal-icon">??</div>
        <div class="modal-title">Logging out?</div>
        <div class="modal-text">You'll need to sign in again to access your dashboard.</div>
        <div class="modal-actions">
            <button class="modal-btn cancel" onclick="closeLogoutModal()">Stay</button>
            <button class="modal-btn confirm" onclick="confirmLogout()">Yes, logout</button>
        </div>
    </div>
</div>

<script src="/js/api.js"></script>

<script>
/* ============================================
   CANVAS ANIMATION — city map network
   (nodes = campaign locations, lines = routes)
============================================ */
(function () {
    const canvas = document.getElementById("bgCanvas");
    const ctx = canvas.getContext("2d");
    let W, H, nodes = [], mouse = { x: -999, y: -999 };

    const NODE_COUNT   = 55;
    const CONNECT_DIST = 130;
    const NODE_COLOR   = "rgba(59,130,246,";
    const LINE_COLOR   = "rgba(99,102,241,";

    function resize() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
    }

    function initNodes() {
        nodes = [];
        for (let i = 0; i < NODE_COUNT; i++) {
            nodes.push({
                x: Math.random() * W,
                y: Math.random() * H,
                vx: (Math.random() - 0.5) * 0.45,
                vy: (Math.random() - 0.5) * 0.45,
                r:  Math.random() * 2.5 + 1.5,
                pulse: Math.random() * Math.PI * 2
            });
        }
    }

    function draw() {
        ctx.clearRect(0, 0, W, H);

        // Background gradient
        const grad = ctx.createLinearGradient(0, 0, W, H);
        grad.addColorStop(0, "#050d1a");
        grad.addColorStop(0.5, "#0a0f1e");
        grad.addColorStop(1, "#080d1c");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        // Update & draw nodes
        nodes.forEach(n => {
            n.x += n.vx;
            n.y += n.vy;
            if (n.x < 0 || n.x > W) n.vx *= -1;
            if (n.y < 0 || n.y > H) n.vy *= -1;
            n.pulse += 0.025;

            const glow = 0.25 + 0.2 * Math.sin(n.pulse);
            const r = n.r + Math.sin(n.pulse) * 0.8;

            ctx.beginPath();
            ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
            ctx.fillStyle = NODE_COLOR + glow + ")";
            ctx.fill();
        });

        // Draw connection lines
        for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
                const dx = nodes[i].x - nodes[j].x;
                const dy = nodes[i].y - nodes[j].y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < CONNECT_DIST) {
                    const alpha = (1 - dist / CONNECT_DIST) * 0.22;
                    ctx.beginPath();
                    ctx.moveTo(nodes[i].x, nodes[i].y);
                    ctx.lineTo(nodes[j].x, nodes[j].y);
                    ctx.strokeStyle = LINE_COLOR + alpha + ")";
                    ctx.lineWidth = 0.8;
                    ctx.stroke();
                }
            }
        }

        // Mouse proximity glow
        nodes.forEach(n => {
            const dx = n.x - mouse.x;
            const dy = n.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
                const alpha = (1 - dist / 100) * 0.55;
                ctx.beginPath();
                ctx.arc(n.x, n.y, n.r * 2.5, 0, Math.PI * 2);
                ctx.fillStyle = "rgba(139,92,246," + alpha + ")";
                ctx.fill();
            }
        });

        requestAnimationFrame(draw);
    }

    window.addEventListener("mousemove", e => { mouse.x = e.clientX; mouse.y = e.clientY; });
    window.addEventListener("resize", () => { resize(); initNodes(); });
    resize();
    initNodes();
    draw();
})();

/* ============================================
   FLOATING CAMPAIGN WORDS
============================================ */
(function () {
    const words = [
        "CAMPAIGN", "TRICHY", "CHENNAI", "COIMBATORE", "MADURAI",
        "WORKER", "PROOF", "APPROVED", "BILLBOARD", "POSTER",
        "LOCATION", "FIELD", "ASSIGNED", "PUBLICITY", "CAMPAIGN",
        "BANNER", "OUTLET", "VERIFIED", "COMPLETED", "SUBMIT"
    ];

    const container = document.getElementById("floatingWords");

    words.forEach((w, i) => {
        const el = document.createElement("div");
        el.className = "word";
        el.innerText = w;
        el.style.left = (Math.random() * 95) + "%";
        el.style.animationDuration = (18 + Math.random() * 18) + "s";
        el.style.animationDelay    = (Math.random() * 14) + "s";
        el.style.fontSize = (10 + Math.random() * 4) + "px";
        el.style.opacity  = (0.08 + Math.random() * 0.14).toString();
        container.appendChild(el);
    });
})();

/* ============================================
   PIN DROP MARKERS
============================================ */
(function () {
    const colors = ["#2563eb","#7c3aed","#16a34a","#ea580c","#0891b2"];
    const container = document.getElementById("pinContainer");

    for (let i = 0; i < 8; i++) {
        const pin = document.createElement("div");
        pin.className = "pin";
        pin.style.left  = (5 + Math.random() * 88) + "%";
        pin.style.top   = (5 + Math.random() * 88) + "%";
        pin.style.background = colors[i % colors.length];
        pin.style.width  = (8 + Math.random() * 6) + "px";
        pin.style.height = (8 + Math.random() * 6) + "px";
        pin.style.animationDelay = (Math.random() * 3) + "s";
        container.appendChild(pin);
    }
})();

/* ============================================
   LOGIN FORM LOGIC
============================================ */
document.addEventListener("DOMContentLoaded", function () {

    const form    = document.getElementById("loginForm");
    const btn     = document.getElementById("loginBtn");
    const btnText = document.getElementById("btnText");
    const alert   = document.getElementById("alertBox");

    function showAlert(msg, type) {
        alert.className = "alert-box " + type;
        alert.innerText = (type === "error" ? "?? " : "? ") + msg;
        alert.style.display = "block";
    }

    form.addEventListener("submit", function (e) {
        e.preventDefault();

        const phone = document.getElementById("phoneInput").value.trim();
        if (!phone) { showAlert("Please enter your phone number", "error"); return; }

        btn.classList.add("loading");
        btnText.innerText = "Signing in…";
        alert.style.display = "none";

        apiFetch("/api/users/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ phoneNumber: phone })
        })
        .then(async res => {
            let data = {};
            try { data = await res.json(); } catch {}
            if (!res.ok) throw new Error(data.message || "Login failed");
            return data;
        })
        .then(data => {
            localStorage.setItem("token", data.token);
            showAlert("Login successful! Redirecting…", "success");

            const role = (data.user?.role || "").toLowerCase().trim();
            setTimeout(() => {
                if      (role === "admin")    window.location.href = "/Dashboard/Index";
                else if (role === "worker")   window.location.href = "/Worker/Dashboard";
                else if (role === "provider") window.location.href = "/Provider/Dashboard";
                else showAlert("Unknown role: " + role, "error");
            }, 800);
        })
        .catch(err => {
            showAlert(err.message, "error");
        })
        .finally(() => {
            btn.classList.remove("loading");
            btnText.innerText = "Login";
        });
    });
});

/* ============================================
   LOGOUT MODAL — global (used by both layouts)
============================================ */
function showLogoutModal() {
    const m = document.getElementById("logoutModal");
    if (m) { m.classList.add("show"); return; }
    // If modal doesn't exist on this page, just logout directly
    confirmLogout();
}

function closeLogoutModal() {
    const m = document.getElementById("logoutModal");
    if (m) m.classList.remove("show");
}

function confirmLogout() {
    localStorage.removeItem("token");
    window.location.href = "/Account/Login";
}
</script>

</body>
</html>
