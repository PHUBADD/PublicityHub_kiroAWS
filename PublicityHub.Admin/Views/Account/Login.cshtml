@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Login – PublicityHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #111827, #020617);
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            padding: 42px 38px;
            border-radius: 16px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.35);
            text-align: center;
        }

        .login-title {
            font-size: 26px;
            font-weight: 700;
            color: #020617;
            margin-bottom: 6px;
        }

        .login-slogan {
            font-size: 14px;
            font-weight: 600;
            color: #166534;
            margin-bottom: 6px;
        }

            .login-slogan.tamil {
                font-size: 13px;
                font-style: italic;
                color: #15803d;
                margin-bottom: 28px;
            }

        .login-card input {
            width: 100%;
            padding: 14px;
            margin-bottom: 18px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
        }

        .login-card button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(180deg, #2563eb, #1e40af);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            position: relative;
        }

            /* ✅ Loading spinner */
            .login-card button.loading {
                pointer-events: none;
                opacity: 0.7;
            }

                .login-card button.loading::after {
                    content: "";
                    width: 18px;
                    height: 18px;
                    border: 2px solid #fff;
                    border-top-color: transparent;
                    border-radius: 50%;
                    position: absolute;
                    right: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    animation: spin 0.8s linear infinite;
                }

        @@keyframes spin {
            to

        {
            transform: translateY(-50%) rotate(360deg);
        }

        }

        .success-box {
            background: #dcfce7;
            color: #166534;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 12px;
        }

        .error-box {
            background: #fee2e2;
            color: #991b1b;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 12px;
        }

        .create-user-section {
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <!-- ✅ API -->
    <script src="/js/api.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector("form");
            const btn = form.querySelector("button");

            if (!form) return;

            form.addEventListener("submit", function (e) {

                e.preventDefault();

                const phone = document.querySelector("input[name='phoneNumber']").value.trim();

                // ✅ Show loading
                btn.classList.add("loading");
                btn.innerText = "Logging in...";

                apiFetch("/api/users/login", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        phoneNumber: phone
                    })
                })

                .then(async res => {

                    // ✅ Read response body safely
                    let errorData = {};
                    try {
                        errorData = await res.json();
                    } catch {
                        errorData = {};
                    }

                    if (!res.ok) {

                        if (res.status === 401) {
                            throw new Error(errorData.message || "Invalid login");
                        }

                        throw new Error(errorData.message || "Server error. Please try again.");
                    }

                    return errorData;
                })

                .then(data => {

                    console.log("Login response:", data);

                    // ✅ Store token
                    localStorage.setItem("token", data.token);

                    // ✅ Show success message
                    alert("✅ Login successful");

                    // ✅ SAFE ROLE READ
                    const role = (data.user && data.user.role)
                        ? data.user.role.toString().trim().toLowerCase()
                        : "";

                    console.log("Role:", role);

                    if (role === "admin") {
                        window.location.href = "/Dashboard/Index";
                    }
                    else if (role === "worker") {
                        window.location.href = "/Worker/Dashboard";
                    }
                    else if (role === "provider") {
                        window.location.href = "/Provider/Dashboard";
                    }
                    else {
                        alert("❌ Unknown role. Cannot redirect.");
                        console.error("Invalid role:", role);
                    }
                })

                .catch(err => {
                    alert("❌ " + err.message);
                    console.error("Login error:", err);
                })

                .finally(() => {
                    // ✅ Reset button
                    btn.classList.remove("loading");
                    btn.innerText = "Login";
                });

            });

        });
    </script>


    <!-- ✅ UI -->
    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-title">PublicityHub Admin</div>

            <div class="login-slogan">
                Built to empower people who work on the ground with dignity and fairness.
            </div>
            <div class="login-slogan tamil">
                நிலத்தில் உழைக்கும் மக்களுக்கு மரியாதையும் நீதியும் வழங்க உருவாக்கப்பட்டது.
            </div>

            <form>
                <input type="text"
                       name="phoneNumber"
                       placeholder="Phone Number"
                       required />

                <button type="submit">Login</button>
            </form>

            <div class="create-user-section">
                <p>Don’t have an account?</p>
                <a href="/User/Create">
                    ➕ Create New User
                </a>
            </div>

        </div>
    </div>

</body>
</html>
``