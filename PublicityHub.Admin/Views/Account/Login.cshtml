@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - PublicityHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;600&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            height: 100vh; overflow: hidden;
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            background: #060d1f;
            display: flex; justify-content: center; align-items: center;
        }
        #bgCanvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; }
        .floating-words { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
        .word {
            position: absolute; font-size: 11px; font-weight: 600;
            letter-spacing: 1.5px; text-transform: uppercase;
            color: rgba(96,165,250,0.22);
            animation: floatUp linear infinite; white-space: nowrap;
        }
        @@keyframes floatUp {
            0%   { transform: translateY(110vh) rotate(-5deg); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 0.7; }
            100% { transform: translateY(-10vh) rotate(5deg); opacity: 0; }
        }
        .pin {
            position: fixed; border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg); animation: pinPulse 3s ease-in-out infinite; z-index: 2;
        }
        @@keyframes pinPulse {
            0%,100% { transform: rotate(-45deg) scale(1);   opacity: 0.5; }
            50%      { transform: rotate(-45deg) scale(1.7); opacity: 1;   }
        }
        .login-scene {
            position: relative; z-index: 10;
            width: 100%; max-width: 420px; padding: 16px;
            animation: cardEnter 0.65s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @@keyframes cardEnter {
            from { opacity: 0; transform: translateY(36px) scale(0.93); }
            to   { opacity: 1; transform: translateY(0)    scale(1);    }
        }
        .login-card {
            background: rgba(8,16,36,0.9);
            backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(99,155,255,0.25);
            border-radius: 22px; padding: 42px 36px 34px;
            box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 28px 60px rgba(0,0,0,0.7), 0 0 90px rgba(37,99,235,0.12);
            text-align: center;
        }
        .logo-mark {
            width: 62px; height: 62px; margin: 0 auto 18px;
            background: linear-gradient(135deg, #1d4ed8, #6d28d9);
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            box-shadow: 0 8px 28px rgba(37,99,235,0.5);
            animation: logoBounce 2.8s ease-in-out infinite;
        }
        @@keyframes logoBounce {
            0%,100% { transform: translateY(0);   }
            50%      { transform: translateY(-7px); }
        }
        .login-title {
            font-size: 27px; font-weight: 800; color: #eef4ff;
            letter-spacing: -0.4px; margin-bottom: 5px;
        }
        .login-subtitle {
            font-size: 13px; color: #7da3d0; margin-bottom: 8px; font-weight: 500;
        }
        .login-slogan {
            font-family: 'Noto Sans Tamil', sans-serif;
            font-size: 13px; color: #38bdf8; margin-bottom: 26px;
            opacity: 0.95; line-height: 1.7;
        }
        .divider { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
        .divider-line { flex: 1; height: 1px; background: rgba(148,163,184,0.14); }
        .divider-text { font-size: 11px; color: #4a6a8a; font-weight: 700; letter-spacing: 0.8px; }
        .input-group { position: relative; margin-bottom: 14px; text-align: left; }
        .input-icon {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            pointer-events: none; display: flex; align-items: center;
        }
        .input-group input {
            width: 100%; padding: 13px 13px 13px 40px;
            background: rgba(18,30,56,0.85);
            border: 1px solid rgba(99,155,255,0.2);
            border-radius: 10px; font-size: 15px; color: #ddeeff;
            outline: none; font-family: 'Inter', sans-serif;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .input-group input::placeholder { color: #3d5a80; }
        .input-group input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.18);
        }
        .btn-login {
            width: 100%; padding: 14px;
            background: linear-gradient(135deg, #1d4ed8 0%, #6d28d9 100%);
            color: #fff; border: none; border-radius: 10px;
            font-size: 15px; font-weight: 700; cursor: pointer;
            position: relative; overflow: hidden;
            transition: transform 0.15s, box-shadow 0.15s;
            margin-top: 4px; letter-spacing: 0.4px;
            font-family: 'Inter', sans-serif;
        }
        .btn-login .shimmer {
            position: absolute; top: 0; left: -100%; width: 55%; height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.15), transparent);
            animation: shimmer 2.8s linear infinite;
        }
        @@keyframes shimmer { 0% { left: -100%; } 100% { left: 210%; } }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(37,99,235,0.52); }
        .btn-login:active { transform: translateY(0); }
        .btn-login.loading { pointer-events: none; opacity: 0.72; }
        .btn-login.loading::after {
            content: ""; width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff;
            border-radius: 50%; position: absolute; right: 16px; top: 50%;
            transform: translateY(-50%); animation: spin 0.65s linear infinite;
        }
        @@keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }
        .alert-box {
            padding: 10px 14px; border-radius: 8px; margin-bottom: 12px;
            font-size: 13px; font-weight: 600; text-align: left; display: none;
        }
        .alert-box.error   { background: rgba(239,68,68,0.14);  color: #fca5a5; border: 1px solid rgba(239,68,68,0.28);  display:block; }
        .alert-box.success { background: rgba(34,197,94,0.12);  color: #86efac; border: 1px solid rgba(34,197,94,0.24);  display:block; }
        .card-footer { margin-top: 20px; font-size: 13px; color: #4a6a8a; }
        .card-footer a { color: #60a5fa; text-decoration: none; font-weight: 600; }
        .card-footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>
<canvas id="bgCanvas"></canvas>
<div class="floating-words" id="floatingWords"></div>
<div id="pinContainer"></div>

<div class="login-scene">
  <div class="login-card">

    <div class="logo-mark">
      <svg width="30" height="34" viewBox="0 0 30 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 0C6.716 0 0 6.716 0 15C0 23.284 15 34 15 34C15 34 30 23.284 30 15C30 6.716 23.284 0 15 0Z" fill="white" fill-opacity="0.95"/>
        <circle cx="15" cy="15" r="6" fill="#1d4ed8"/>
      </svg>
    </div>

    <div class="login-title">PublicityHub</div>
    <div class="login-subtitle">Field Campaign Management Platform</div>
    <div class="login-slogan">நிலத்தில் உழைக்கும் மக்களுக்கு மரியாதையும் நீதியும்</div>

    <div class="divider">
      <div class="divider-line"></div>
      <div class="divider-text">SIGN IN</div>
      <div class="divider-line"></div>
    </div>

    <div id="alertBox" class="alert-box"></div>

    <form id="loginForm" autocomplete="off">
      <div class="input-group">
        <span class="input-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4b7ab5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
        </span>
        <input type="tel" name="phoneNumber" id="phoneInput"
               placeholder="Enter your phone number" maxlength="10" required />
      </div>

      <button type="submit" class="btn-login" id="loginBtn">
        <span class="shimmer"></span>
        <span id="btnText">Sign In</span>
      </button>
    </form>

    <div class="card-footer">
      New user? <a href="/User/Create">Create account</a>
    </div>
  </div>
</div>

<script src="/js/api.js"></script>
<script>
(function(){
  const canvas=document.getElementById("bgCanvas"),ctx=canvas.getContext("2d");
  let W,H,nodes=[],mouse={x:-999,y:-999};
  const N=52,D=125;
  function resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;}
  function init(){nodes=Array.from({length:N},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*2.2+1.3,p:Math.random()*Math.PI*2}));}
  function draw(){
    ctx.clearRect(0,0,W,H);
    const g=ctx.createLinearGradient(0,0,W,H);
    g.addColorStop(0,"#040a18");g.addColorStop(.5,"#060d1f");g.addColorStop(1,"#050b1a");
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    nodes.forEach(n=>{
      n.x+=n.vx;n.y+=n.vy;n.p+=.022;
      if(n.x<0||n.x>W)n.vx*=-1;if(n.y<0||n.y>H)n.vy*=-1;
      const glow=.28+.18*Math.sin(n.p);
      ctx.beginPath();ctx.arc(n.x,n.y,n.r+Math.sin(n.p)*.7,0,Math.PI*2);
      ctx.fillStyle="rgba(59,130,246,"+glow+")";ctx.fill();
    });
    for(let i=0;i<nodes.length;i++)for(let j=i+1;j<nodes.length;j++){
      const dx=nodes[i].x-nodes[j].x,dy=nodes[i].y-nodes[j].y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<D){ctx.beginPath();ctx.moveTo(nodes[i].x,nodes[i].y);ctx.lineTo(nodes[j].x,nodes[j].y);
        ctx.strokeStyle="rgba(99,102,241,"+(1-d/D)*.2+")";ctx.lineWidth=.7;ctx.stroke();}
    }
    nodes.forEach(n=>{
      const d=Math.hypot(n.x-mouse.x,n.y-mouse.y);
      if(d<90){ctx.beginPath();ctx.arc(n.x,n.y,n.r*2.8,0,Math.PI*2);ctx.fillStyle="rgba(139,92,246,"+(1-d/90)*.5+")";ctx.fill();}
    });
    requestAnimationFrame(draw);
  }
  window.addEventListener("mousemove",e=>{mouse.x=e.clientX;mouse.y=e.clientY;});
  window.addEventListener("resize",()=>{resize();init();});
  resize();init();draw();
})();

(function(){
  const words=["CAMPAIGN","TRICHY","CHENNAI","COIMBATORE","MADURAI","WORKER","PROOF","APPROVED","BILLBOARD","POSTER","LOCATION","FIELD","ASSIGNED","PUBLICITY","BANNER","VERIFIED","COMPLETED"];
  const c=document.getElementById("floatingWords");
  words.forEach(w=>{
    const el=document.createElement("div");el.className="word";el.innerText=w;
    el.style.left=(Math.random()*94)+"%";
    el.style.animationDuration=(16+Math.random()*20)+"s";
    el.style.animationDelay=(Math.random()*15)+"s";
    el.style.fontSize=(9+Math.random()*4)+"px";
    c.appendChild(el);
  });
})();

(function(){
  const colors=["#2563eb","#7c3aed","#16a34a","#ea580c","#0891b2","#db2777"];
  const c=document.getElementById("pinContainer");
  for(let i=0;i<9;i++){
    const p=document.createElement("div");p.className="pin";
    p.style.left=(4+Math.random()*88)+"%";p.style.top=(4+Math.random()*88)+"%";
    p.style.background=colors[i%colors.length];
    const s=9+Math.random()*7;p.style.width=s+"px";p.style.height=s+"px";
    p.style.animationDelay=(Math.random()*3)+"s";
    c.appendChild(p);
  }
})();

document.addEventListener("DOMContentLoaded",function(){
  const form=document.getElementById("loginForm");
  const btn=document.getElementById("loginBtn");
  const btnText=document.getElementById("btnText");
  const alertBox=document.getElementById("alertBox");

  function showAlert(msg,type){
    alertBox.className="alert-box "+type;
    alertBox.innerText=(type==="error"?"Error: ":"OK: ")+msg;
    alertBox.style.display="block";
  }

  form.addEventListener("submit",function(e){
    e.preventDefault();
    const phone=document.getElementById("phoneInput").value.trim();
    if(!phone){showAlert("Please enter your phone number","error");return;}
    btn.classList.add("loading");btnText.innerText="Signing in...";
    alertBox.style.display="none";

    apiFetch("/api/users/login",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({phoneNumber:phone})
    })
    .then(async res=>{
      let data={};try{data=await res.json();}catch{}
      if(!res.ok)throw new Error(data.message||"Login failed");
      return data;
    })
    .then(data=>{
      localStorage.setItem("token",data.token);
      showAlert("Login successful! Redirecting...","success");
      const role=(data.user?.role||"").toLowerCase().trim();
      setTimeout(()=>{
        if(role==="admin")window.location.href="/Dashboard/Index";
        else if(role==="worker")window.location.href="/Worker/Dashboard";
        else if(role==="provider")window.location.href="/Provider/Dashboard";
        else showAlert("Unknown role: "+role,"error");
      },700);
    })
    .catch(err=>{showAlert(err.message,"error");})
    .finally(()=>{btn.classList.remove("loading");btnText.innerText="Sign In";});
  });
});
</script>
</body>
</html>