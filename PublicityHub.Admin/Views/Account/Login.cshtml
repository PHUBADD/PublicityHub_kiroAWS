@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Login – PublicityHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #111827, #020617);
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            padding: 42px 38px;
            border-radius: 16px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.35);
            text-align: center;
        }

        .login-title {
            font-size: 26px;
            font-weight: 700;
            color: #020617;
            margin-bottom: 6px;
        }

        .login-slogan {
            font-size: 14px;
            font-weight: 600;
            color: #166534;
            margin-bottom: 6px;
        }

            .login-slogan.tamil {
                font-size: 13px;
                font-style: italic;
                color: #15803d;
                margin-bottom: 28px;
            }

        .login-card input {
            width: 100%;
            padding: 14px;
            margin-bottom: 18px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
            outline: none;
            transition: border 0.15s ease;
        }

            .login-card input:focus {
                border-color: #2563eb;
            }

        .login-card button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(180deg, #2563eb, #1e40af);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

            .login-card button:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(37,99,235,0.35);
            }

        .error {
            margin-top: 16px;
            color: #b91c1c;
            font-size: 14px;
        }

        .footer-text {
            margin-top: 28px;
            font-size: 12px;
            color: #64748b;
            letter-spacing: 0.02em;
        }

        .error-box {
            background: #fee2e2;
            color: #991b1b;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 12px;
        }

        /*  Create section */
        .create-user-section {
            margin-top: 20px;
        }

            .create-user-section p {
                font-size: 13px;
                color: #6b7280;
            }

    </style>

</head>

<body>

    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-title">PublicityHub Admin</div>

            <!-- ✅ SLOGAN (EN + TA) -->
            <div class="login-slogan">
                Built to empower people who work on the ground with dignity and fairness.
            </div>
            <div class="login-slogan tamil">
                நிலத்தில் உழைக்கும் மக்களுக்கு மரியாதையும் நீதியும் வழங்க உருவாக்கப்பட்டது.
            </div>

            <form method="post" action="/Account/Login">
                <input type="text"
                       name="phoneNumber"
                       placeholder="Admin Phone Number"
                       required />

                <button type="submit">Login</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="error">
                    @ViewBag.Error
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }

            <!-- Error Message -->
            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    @ViewBag.Error
                </div>
            }

            <!-- ✅ CREATE USER SECTION -->
            <div class="create-user-section">
                <p>Don’t have an account?</p>

                <a href="/User/Create" class="btn secondary">
                    ➕ Create New User
                </a>
            </div>

            
            <div class="footer-text">
                Secure administrative access only
            </div>

        </div>
    </div>

</body>
</html>