@{
    Layout = "_Layout";
}

<div class="auth-container">

    <h2>Create New User</h2>

    <div class="form-group">
        <label>Name</label>
        <input type="text" id="name" placeholder="Enter name" />
    </div>

    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" id="phone" placeholder="Enter phone number" />
    </div>

    <button class="btn primary" onclick="createUser(this)">
        Create User
    </button>

    <div id="message" class="message"></div>

</div>

<script>
    function createUser(btn) {

        const name = document.getElementById("name").value;
        const phone = document.getElementById("phone").value;

        if (!name || !phone) {
            showMessage("❌ Name & Phone required", false);
            return;
        }

        btn.disabled = true;
        btn.innerText = "Creating...";

        fetch(`${window.API_BASE}/api/Users`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                name: name,
                phoneNumber: phone
            })
        })
        .then(async res => {
            if (!res.ok) {
                const msg = await res.text();
                throw new Error(msg);
            }
        })
        .then(() => {
            showMessage("✅ User created successfully!", true);

            setTimeout(() => {
                window.location.href = "/Account/Login";
            }, 1500);
        })
        .catch(err => {
            showMessage("❌ " + err.message, false);

            btn.disabled = false;
            btn.innerText = "Create User";
        });
    }

    function showMessage(msg, isSuccess) {
        const el = document.getElementById("message");
        el.innerText = msg;
        el.style.color = isSuccess ? "green" : "red";
    }
</script>

<style>
    .auth-container {
        max-width: 400px;
        margin: auto;
        margin-top: 60px;
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 15px;
    }

    input {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
    }

    .btn.primary {
        width: 100%;
        padding: 10px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .message {
        margin-top: 15px;
    }
</style>
