@{
    Layout = "_Layout";
    ViewData["Title"] = "PublicityHub – Business Vision";
}

<div class="vision-container">

    <h1 class="vision-title">PublicityHub – Business Vision & Flow</h1>
    <p class="vision-subtitle">
        A daily reminder of why this platform exists and how every role works together.
    </p>

    <!-- CORE BUSINESS OBJECTIVE -->
    <section class="vision-section">
        <h2>🎯 Core Business Objective</h2>
        <div class="card">
            PublicityHub is a trusted execution platform that connects
            <strong>Business Owners</strong>, <strong>Business Partners</strong>,
            and <strong>Field Workers</strong>, while the
            <strong>Platform (Admin)</strong> ensures trust, quality, and fair outcomes.
        </div>
    </section>

    <!-- PLATFORM ROLES -->
    <section class="vision-section">
        <h2>👥 Platform Roles</h2>

        <div class="role-grid">
            <div class="card">
                <h3>🧑‍💼 Business Owner / Client</h3>
                <ul>
                    <li>Creates campaigns</li>
                    <li>Selects services</li>
                    <li>Pays for outcome</li>
                    <li>Does NOT approve proofs</li>
                </ul>
            </div>

            <div class="card">
                <h3>🏭 Business Partner</h3>
                <ul>
                    <li>Produces materials</li>
                    <li>Accepts orders</li>
                    <li>Uploads fulfillment proof</li>
                </ul>
            </div>

            <div class="card">
                <h3>🧑‍🔧 Worker (Field Executor)</h3>
                <ul>
                    <li>Executes field work</li>
                    <li>Uploads proof</li>
                    <li>Never validates own work</li>
                </ul>
            </div>

            <div class="card admin">
                <h3>🧑‍⚖️ Admin (Platform Authority)</h3>
                <ul>
                    <li>Verifies proofs</li>
                    <li>Approves / Rejects</li>
                    <li>Controls payouts</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- BUSINESS FLOW -->
    <section class="vision-section">
        <h2>🔄 End‑to‑End Business Flow</h2>
        <pre class="flow">
Business Owner
  ↓
Campaign Created
  ↓
Partner Produces
  ↓
Worker Executes
  ↓
Proof Uploaded
  ↓
Admin Verification
  ↓
Completion & Payment
        </pre>
    </section>

    <!-- DAILY REMINDER -->
    <section class="vision-section reminder">
        <h2>🧠 Daily Admin Reminder</h2>
        <p>
            You are building a trust platform, not just an application.
        </p>
        <p class="quote">
            “Clarity today prevents chaos tomorrow.”
        </p>
    </section>

    <!-- GROUND WORKERS -->
    <section class="vision-section positive">
        <h2>Built for the People on the Ground</h2>
        <p>
            Built to empower people who work on the ground with dignity and fairness.
        </p>
        <p class="tamil">
            நிலத்தில் உழைக்கும் மக்களுக்கு மரியாதையும் நீதியும் வழங்க உருவாக்கப்பட்டது.
        </p>
    </section>

</div>

<style>
    /* ===== THEME VARIABLES ===== */
    :root {
        --bg-main: var(--bg-main);
        --bg-card: var(--card-bg);
        --bg-soft: #fefce8;
        --bg-positive: #ecfdf5;
        --text-main: var(--text-main);
        --text-muted: #64748b;
        --border: #cbd5f5;
    }

    body[data-theme="dark"] {
        --bg-soft: #1e293b;
        --bg-positive: #052e16;
        --text-muted: #94a3b8;
        --border: #334155;
    }

    /* ===== LAYOUT ===== */
    .vision-container {
        max-width: 1000px;
        margin: auto;
        padding: 40px 24px;
    }

    .vision-title {
        font-size: 32px;
        color: var(--text-main);
    }

    .vision-subtitle {
        color: var(--text-muted);
        margin-bottom: 40px;
    }

    .vision-section {
        margin-bottom: 50px;
    }

    /* ===== CARDS ===== */
    .card {
        background: var(--bg-card);
        color: var(--text-main);
        padding: 22px;
        border-radius: 14px;
        border: 1px solid var(--border);
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    .role-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 22px;
    }

    .card.admin {
        border: 2px solid #2563eb;
    }

    /* ===== FLOW ===== */
    .flow {
        background: #020617;
        color: #e5e7eb;
        padding: 24px;
        border-radius: 14px;
    }

    /* ===== REMINDERS ===== */
    .reminder {
        background: var(--bg-soft);
        border-radius: 16px;
        padding: 26px;
    }

    .positive {
        background: var(--bg-positive);
        border-radius: 16px;
        padding: 26px;
    }

    .quote {
        font-style: italic;
        color: var(--text-muted);
    }

    .tamil {
        font-style: italic;
        color: var(--text-muted);
    }
</style>