@using PublicityHub.Admin.Models
@model List<CampaignViewModel>

@{
    Layout = "_Layout";
}

<h2>Campaign Overview</h2>

<a href="/Campaign/Create" class="btn primary">
    ➕ Create Campaign
</a>

@if (!Model.Any())
{
    <p>No campaigns found.</p>
}
else
{
    <div class="campaign-grid">
        @foreach (var campaign in Model)
        {
            <div class="campaign-card">

                <div class="card-header">
                    <h3>@campaign.Title</h3>
                    <span class="status-badge @campaign.Status.ToLower()">
                        @campaign.Status
                    </span>
                </div>

                <p><strong>Amount:</strong> ₹@campaign.Amount</p>
                <p><strong>Created By:</strong> @campaign.CreatedByName</p>

                @if (campaign.AssignedCount > 0)
                {
                    <span class="badge success">
                        👷 @campaign.AssignedCount Worker(s) Assigned
                    </span>
                }

                @if (campaign.Status == "Closed")
                {
                    <span class="badge closed">
                        🚫 Campaign Closed
                    </span>
                }

                @if (campaign.Status == "Completed")
                {
                    <span class="badge completed">
                        ✅ Campaign Completed
                    </span>
                }

                <div class="card-actions">

                    @* Publish only in Draft *@
                    @if (campaign.Status == "Draft")
                    {
                        <button class="btn publish"
                                onclick="publish(@campaign.Id, this)">
                            Publish
                        </button>
                    }

                    @* Close only in Draft or Published *@
                    @if (campaign.Status == "Draft" || campaign.Status == "Published")
                    {
                        <button class="btn close"
                                onclick="closeCampaign(@campaign.Id, this)">
                            Close
                        </button>
                    }

                    @* Complete only in InExecution *@
                    @if (campaign.Status == "InExecution")
                    {
                        <button class="btn complete"
                                onclick="complete(@campaign.Id, this)">
                            Complete
                        </button>
                    }
                </div>

                <a class="proof-link"
                   href="/Proof/ByCampaign/@campaign.Id">
                    View proofs →
                </a>

                @if (campaign.Status == "Published" || campaign.Status == "InExecution")
                {
                    <a href="/JobAssignment/Assign/@campaign.Id"
                       class="btn assign">
                        👷 Assign Worker
                    </a>
                }
                else
                {
                    <span class="btn disabled">
                        👷 Assign Worker
                    </span>
                }
            </div>
        }
    </div>
}

<script>
    // ✅ Using relative path -> works with NGINX (no hardcoding)

    function disable(btn) {
        btn.disabled = true;
        btn.innerText = "Processing...";
        btn.style.opacity = "0.7";
    }

    function publish(id, btn) {
        disable(btn);

        // ✅ Calls API via same domain → /api handled by NGINX
        fetch(`/api/Campaigns/${id}/publish`, { method: "POST" })
            .then(() => {
                alert("✅ Campaign published successfully");
                location.reload();
            });
    }

    function complete(id, btn) {
        disable(btn);

        fetch(`/api/Campaigns/${id}/complete`, { method: "POST" })
            .then(() => {
                alert("✅ Campaign completed");
                location.reload();
            });
    }

    function closeCampaign(id, btn) {
        if (!confirm("Are you sure you want to close this campaign?")) {
            return;
        }

        disable(btn);

        fetch(`/api/Campaigns/${id}/close`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                closedBy: 1,
                reason: "Closed by admin from dashboard"
            })
        }).then(() => {
            alert("🚫 Campaign closed successfully");
            location.reload();
        });
    }
</script>

<style>
    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .campaign-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .status-badge {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 12px;
        color: white;
        font-weight: 600;
    }

        .status-badge.draft {
            background: #6b7280;
        }

        .status-badge.published {
            background: #2563eb;
        }

        .status-badge.inexecution {
            background: #ca8a04;
        }

        .status-badge.completed {
            background: #15803d;
        }

        .status-badge.closed {
            background: #b91c1c;
        }

    .badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

        .badge.success {
            background: #dcfce7;
            color: #166534;
        }

        .badge.completed {
            background: #dcfce7;
            color: #166534;
        }

        .badge.closed {
            background: #fee2e2;
            color: #991b1b;
        }

    .card-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
    }

    .btn {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-size: 13px;
    }

        .btn.publish {
            background: #2563eb;
            color: white;
        }

        .btn.complete {
            background: #15803d;
            color: white;
        }

        .btn.close {
            background: #b91c1c;
            color: white;
        }

        .btn.assign {
            background: #2563eb;
            color: white;
        }

        .btn.disabled {
            background: #e5e7eb;
            color: #6b7280;
            cursor: not-allowed;
        }

    .proof-link {
        font-size: 13px;
        color: #2563eb;
        text-decoration: none;
    }
</style>
