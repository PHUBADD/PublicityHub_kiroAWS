@model List<CampaignViewModel>

@{
    Layout = "_Layout";
}

<h2>Campaign Overview</h2>

@if (!Model.Any())
{
    <p>No campaigns found.</p>
}
else
{
    <div class="campaign-grid">
        @foreach (var campaign in Model)
        {
            <a href="/Proof/ByCampaign/@campaign.Id" style="text-decoration:none;">
                <div class="campaign-card clickable">
                    <h3>@campaign.Title</h3>

                    <p>
                        <strong>Amount:</strong> ₹@campaign.Amount
                    </p>
                    <p>
                        <strong>Created By:</strong> @campaign.CreatedByName
                    </p>

                    <p class="hint">Click to view proofs →</p>
                </div>
            </a>
        }
    </div>
}

<style>
    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .campaign-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .campaign-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.12);
        }

        .campaign-card h3 {
            margin-top: 0;
            color: #1f2937;
        }

        .campaign-card p {
            margin: 8px 0;
            font-size: 14px;
            color: #374151;
        }

    .hint {
        margin-top: 10px;
        font-size: 12px;
        color: #2563eb;
    }

    .clickable {
        cursor: pointer;
    }
</style>