@using PublicityHub.Admin.Models
@model List<ProofViewModel>

@{
    Layout = "_Layout";
}

<h2 class="page-title">
    Proof Review – Campaign @ViewBag.CampaignId
</h2>

@if (!Model.Any())
{
    <p class="empty-text">
        No proofs uploaded for this campaign yet.
    </p>
}
else
{
    <div class="proof-grid">
        @foreach (var proof in Model)
        {
            <div class="proof-card">

                <!-- Proof Image -->
                <div class="proof-image">
                    <img src="@proof.ImageUrl" alt="Proof image" />
                </div>

                <!-- Proof Info -->
                <div class="proof-info">
                    <span class="status-badge @proof.Status.ToLower()">
                        @proof.Status
                    </span>
                </div>

                <!-- Admin Actions -->
                @if (proof.Status == "UnderReview")
                {
                    <div class="proof-actions">
                        <button class="btn approve"
                                onclick="approve(@proof.Id, this)">
                            ✅ Approve
                        </button>

                        <button class="btn reject"
                                onclick="reject(@proof.Id, this)">
                            ❌ Reject
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

<script>
    function approve(id, btn) {
        btn.disabled = true;
        btn.innerText = "Approving...";

        fetch(`https://localhost:7166/api/Proofs/${id}/approve`, {
            method: "POST"
        }).then(() => location.reload());
    }

    function reject(id, btn) {
        btn.disabled = true;
        btn.innerText = "Rejecting...";

        fetch(`https://localhost:7166/api/Proofs/${id}/reject`, {
            method: "POST"
        }).then(() => location.reload());
    }
</script>

<style>
    .page-title {
        margin-bottom: 20px;
        color: #111827;
    }

    .empty-text {
        color: #6b7280;
        font-size: 14px;
    }

    .proof-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
        margin-top: 20px;
    }

    .proof-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .proof-image {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: 8px;
        background: #f3f4f6;
    }

        .proof-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .proof-info {
        display: flex;
        justify-content: flex-start;
    }

    .status-badge {
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .status-badge.uploaded,
        .status-badge.underreview {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.approved {
            background: #dcfce7;
            color: #166534;
        }

        .status-badge.rejected {
            background: #fee2e2;
            color: #991b1b;
        }

    .proof-actions {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

    .btn {
        flex: 1;
        padding: 10px;
        font-size: 14px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
    }

        .btn.approve {
            background: #16a34a;
            color: white;
        }

        .btn.reject {
            background: #dc2626;
            color: white;
        }

        .btn:hover {
            opacity: 0.9;
        }
</style>