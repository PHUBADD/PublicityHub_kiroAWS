@model List<ProofViewModel>

@{
    Layout = "_Layout";
}

<h2 class="page-title">
    Proofs for Campaign @ViewBag.CampaignId
</h2>

@if (!Model.Any())
{
    <p class="empty-text">
        No proofs uploaded for this campaign yet.
    </p>
}
else
{
    <div class="proof-grid">
        @foreach (var proof in Model)
        {
            <div class="proof-card">

                <div class="proof-image">
                    <img src="@proof.ImageUrl" alt="Proof image" />
                </div>

                <div class="proof-info">
                    <span class="status @proof.Status.ToLower()">
                        @proof.Status
                    </span>
                </div>

                <div class="proof-actions">
                    <form method="post" action="/Proof/Approve">
                        <input type="hidden" name="id" value="@proof.Id" />
                        <button type="submit" class="btn approve">
                            ✓ Approve
                        </button>
                    </form>

                    <form method="post" action="/Proof/Reject">
                        <input type="hidden" name="id" value="@proof.Id" />
                        <button type="submit" class="btn reject">
                            ✕ Reject
                        </button>
                    </form>
                </div>

            </div>
        }
    </div>
}

<style>
    .page-title {
        margin-bottom: 20px;
        color: #111827;
    }

    .empty-text {
        color: #6b7280;
        font-size: 14px;
    }

    .proof-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
        margin-top: 20px;
    }

    .proof-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .proof-image {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: 8px;
        background: #f3f4f6;
    }

        .proof-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .proof-info {
        display: flex;
        justify-content: flex-start;
    }

    .status {
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .status.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status.approved {
            background: #dcfce7;
            color: #166534;
        }

        .status.rejected {
            background: #fee2e2;
            color: #991b1b;
        }

    .proof-actions {
        display: flex;
        gap: 10px;
    }

        .proof-actions form {
            flex: 1;
        }

    .btn {
        width: 100%;
        padding: 10px;
        font-size: 14px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
    }

        .btn.approve {
            background: #16a34a;
            color: white;
        }

        .btn.reject {
            background: #dc2626;
            color: white;
        }

        .btn:hover {
            opacity: 0.9;
        }
</style>