@model List<ProofViewModel>

@{
    Layout = "_Layout";
}

<h2>All Proofs</h2>

@if (!Model.Any())
{
    <p>No proofs available.</p>
}
else
{
    <ul>
        @foreach (var proof in Model)
        {
            <li>
                Proof ID: @proof.Id |
                Status: @proof.Status
            </li>
        }
    </ul>
}