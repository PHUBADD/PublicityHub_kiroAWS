@model List<ProofViewModel>
@{ Layout = "_Layout"; }

<h2 class="page-title">All Proofs</h2>

@if (!Model.Any())
{
    <p class="empty-text">No proofs available.</p>
}
else
{
    <div class="proof-grid">
        @foreach (var proof in Model)
        {
            <div class="proof-card">
                <div class="proof-image">
                    <img src="@proof.ImageUrl" alt="Proof" onerror="this.src='/img/placeholder.png'" />
                </div>
                <div class="proof-meta">
                    <p><strong>Proof #@proof.Id</strong></p>
                    <p>Assignment: @proof.AssignmentId</p>
                    <span class="status-badge @proof.Status.ToLower()">@proof.Status</span>
                </div>
                @if (proof.Status == "UnderReview")
                {
                    <div class="proof-actions">
                        <form method="post" asp-action="Approve" asp-route-id="@proof.Id" style="display:inline">
                            <button type="submit" class="btn approve">✅ Approve</button>
                        </form>
                        <form method="post" asp-action="Reject" asp-route-id="@proof.Id" style="display:inline">
                            <button type="submit" class="btn reject">❌ Reject</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .page-title { margin-bottom: 20px; }
    .empty-text { color: #6b7280; }
    .proof-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 20px; }
    .proof-card { background: white; border-radius: 12px; box-shadow: 0 6px 16px rgba(0,0,0,0.08); padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .proof-image { width: 100%; height: 160px; overflow: hidden; border-radius: 8px; background: #f3f4f6; }
    .proof-image img { width: 100%; height: 100%; object-fit: cover; }
    .proof-meta p { margin: 3px 0; font-size: 13px; }
    .status-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
    .status-badge.underreview { background: #fef3c7; color: #92400e; }
    .status-badge.approved { background: #dcfce7; color: #166534; }
    .status-badge.rejected { background: #fee2e2; color: #991b1b; }
    .proof-actions { display: flex; gap: 8px; }
    .btn { flex: 1; padding: 8px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 13px; }
    .btn.approve { background: #16a34a; color: white; }
    .btn.reject { background: #dc2626; color: white; }
</style>
